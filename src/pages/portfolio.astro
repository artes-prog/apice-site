---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Foto from '../components/Foto.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { getPortfolioPublicado, nomeTecnica } from '../lib/content';
import { mensagens } from '../lib/whatsapp';

const itens = await getPortfolioPublicado();

const title = 'Portfólio — Trabalhos Reais Entregues | Ápice Brindes';
const description =
  'Veja brindes personalizados que a Ápice já produziu e entregou para empresas em Goiânia: canecas, chaveiros, garrafas e mais, com produção própria.';
---
<BaseLayout title={title} description={description} waMensagem={mensagens.generico} waSemente="portfolio">
  <div class="container-site crumbs-wrap">
    <Breadcrumbs items={[{ name: 'Início', href: '/' }, { name: 'Portfólio' }]} />
  </div>

  <section class="port-hero">
    <div class="container-site">
      <h1 class="port-hero__title">Trabalhos reais que já saíram da nossa produção</h1>
      <p class="port-hero__lead">
        Sem foto de catálogo genérica: aqui é brinde que já foi entregue de verdade para empresas de Goiânia e
        região, com a marca de cada cliente aplicada na nossa produção própria.
      </p>
    </div>
  </section>

  {itens.length > 0 && (
    <section class="section">
      <div class="container-site">
        <div class="port-grid">
          {itens.map((item) => (
            <article class="port-card">
              <Foto
                src={item.data.foto}
                alt={`${item.data.produto} personalizado para ${item.data.cliente}`}
                ratio="3/4"
              />
              <div class="port-card__body">
                <p class="port-card__cliente">{item.data.cliente}</p>
                <p class="port-card__produto">{item.data.produto}</p>
                <span class="port-card__tec">{nomeTecnica(item.data.tecnica)}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaFinal semente="portfolio" mensagem={mensagens.generico} titulo="Quer um brinde assim com a marca da sua empresa?" />
</BaseLayout>

<style>
  .crumbs-wrap { padding-block: 1.1rem 0; }
  .port-hero { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .port-hero__title { font-size: clamp(1.9rem, 5vw, 2.9rem); font-weight: 800; max-width: 24ch; }
  .port-hero__lead { margin-top: 1.1rem; color: var(--color-ink-soft); font-size: 1.1rem; max-width: 60ch; }

  .section { padding-block: clamp(1.5rem, 4vw, 3rem); }

  .port-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 560px) { .port-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .port-grid { grid-template-columns: repeat(3, 1fr); } }

  .port-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .port-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }
  .port-card :global(.foto) { border-radius: 0; }
  .port-card__body { padding: 1rem 1.1rem 1.2rem; }
  .port-card__cliente { font-family: var(--font-display); font-weight: 700; color: var(--color-apice-blue); }
  .port-card__produto { color: var(--color-ink-soft); font-size: 0.92rem; margin-top: 0.2rem; }
  .port-card__tec {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-apice-red);
  }
</style>
