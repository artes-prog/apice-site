---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site, enderecoLinha } from '../data/site';
import { mensagens } from '../lib/whatsapp';

const msg = mensagens.categoria('brindes');
const mapQuery = encodeURIComponent(`${site.nome}, ${enderecoLinha()}`);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLink = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;

const title = 'Brindes Personalizados em Goiânia | Produção Própria | Ápice';
const description =
  'Brindes personalizados em Goiânia com produção própria de silk e laser. Atendimento presencial no Setor Bela Vista, entrega em toda a região metropolitana e retirada na unidade. Orçamento no WhatsApp.';
---
<BaseLayout title={title} description={description} waMensagem={msg} waSemente="goiania">
  <div class="container-site crumbs-wrap">
    <Breadcrumbs items={[{ name: 'Início', href: '/' }, { name: 'Brindes personalizados em Goiânia' }]} />
  </div>

  <section class="local-hero">
    <div class="container-site">
      <h1 class="local-hero__title">Brindes personalizados em Goiânia, com fábrica na cidade</h1>
      <div class="local-hero__lead">
        <p>
          Procurando <strong>brindes personalizados em Goiânia</strong> com quem realmente produz? A Ápice fica no
          <strong> {site.endereco.bairro}</strong> e faz silk screen e gravação a laser fibra em produção própria —
          nada de intermediário. Isso encurta o prazo, dá controle total de qualidade e resolve de perto: você fala
          com a nossa equipe, aprova a arte e acompanha o pedido sem ruído.
        </p>
        <p>
          Atendemos empresas, RHs, agências, comitês de formatura e comércio de Goiânia e de toda a região. Você
          escolhe entre <strong>retirar na nossa unidade</strong> ou <strong>receber a entrega</strong> — combinamos
          a logística no fechamento do orçamento.
        </p>
      </div>
      <CtaWhatsApp variante="primario" mensagem={msg} semente="goiania" label="Falar com a Ápice no WhatsApp" />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container-site regiao">
      <div class="regiao__text">
        <h2 class="section__title">Onde a gente atende</h2>
        <p class="section__sub">Cobertura em Goiânia e região metropolitana:</p>
        <ul class="regiao__cidades">
          {site.areaAtendimento.map((c) => (<li>{c}</li>))}
        </ul>
      </div>
      <div class="regiao__nap">
        <h2 class="regiao__nap-title">Nossa unidade</h2>
        <address>
          <p class="nap-nome">{site.nome}</p>
          <p>{enderecoLinha()}</p>
          <p>Telefone: {site.telefoneFixo}</p>
          <p>{site.horario}</p>
        </address>
        <a href={mapLink} target="_blank" rel="noopener noreferrer" class="regiao__map-link">Como chegar (Google Maps) →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site">
      <h2 class="section__title section__title--center">No mapa</h2>
      <div class="map-wrap">
        <iframe
          title={`Localização da ${site.nome} em Goiânia`}
          src={mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <CtaFinal semente="goiania" mensagem={msg} titulo="Precisa de brindes personalizados em Goiânia?" />
</BaseLayout>

<style>
  .crumbs-wrap { padding-block: 1.1rem 0; }
  .local-hero { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .local-hero__title { font-size: clamp(2rem, 5.2vw, 2.9rem); font-weight: 800; max-width: 22ch; }
  .local-hero__lead { margin: 1.25rem 0 1.75rem; max-width: 68ch; }
  .local-hero__lead p { color: var(--color-ink-soft); font-size: 1.05rem; margin-bottom: 1rem; }

  .section { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .section--alt { background: var(--color-paper-soft); }
  .section__title { font-size: clamp(1.5rem, 4vw, 2.1rem); }
  .section__title--center { text-align: center; margin-bottom: 1.75rem; }
  .section__sub { color: var(--color-ink-soft); margin: 0.4rem 0 1rem; }

  .regiao { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .regiao__cidades {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .regiao__cidades li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .regiao__cidades li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-apice-red);
    flex: none;
  }
  .regiao__nap {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    box-shadow: var(--shadow-card);
  }
  .regiao__nap-title { font-size: 1.2rem; margin-bottom: 0.9rem; }
  .regiao__nap address { font-style: normal; display: grid; gap: 0.35rem; color: var(--color-ink-soft); }
  .nap-nome { font-weight: 700; color: var(--color-apice-blue); }
  .regiao__map-link { display: inline-block; margin-top: 1rem; font-weight: 700; color: var(--color-apice-blue); }
  .regiao__map-link:hover { text-decoration: underline; }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-card);
  }
  .map-wrap iframe { display: block; width: 100%; height: 420px; border: 0; }

  @media (min-width: 800px) {
    .regiao { grid-template-columns: 1.2fr 1fr; align-items: start; }
  }
</style>
