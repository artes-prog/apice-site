---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import FaqSection from '../components/FaqSection.astro';
import { site, enderecoLinha, redesFooter } from '../data/site';
import { getFaqsDaPagina } from '../lib/content';
import { mensagens } from '../lib/whatsapp';

const faqs = await getFaqsDaPagina('contato');
const redes = redesFooter();
const mapQuery = encodeURIComponent(`${site.nome}, ${enderecoLinha()}`);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLink = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;

const title = 'Contato | Ápice Brindes — Goiânia';
const description =
  'Fale com a Ápice Brindes em Goiânia: WhatsApp, telefone, endereço no Setor Bela Vista e horário de atendimento. Orçamento rápido e sem compromisso.';
---
<BaseLayout title={title} description={description} waMensagem={mensagens.generico} waSemente="contato">
  <div class="container-site crumbs-wrap">
    <Breadcrumbs items={[{ name: 'Início', href: '/' }, { name: 'Contato' }]} />
  </div>

  <section class="ct-hero">
    <div class="container-site">
      <h1 class="ct-hero__title">Fale com a Ápice</h1>
      <p class="ct-hero__lead">O jeito mais rápido é o WhatsApp — respondemos em horário comercial, geralmente em poucos minutos.</p>
    </div>
  </section>

  <section class="section">
    <div class="container-site ct-grid">
      <div class="ct-info">
        <h2 class="ct-block-title">Onde estamos</h2>
        <address class="nap">
          <p class="nap-nome">{site.nome}</p>
          <p>{enderecoLinha()}</p>
          <p>Telefone: {site.telefoneFixo}</p>
          <p>{site.horario}</p>
        </address>
        <a href={mapLink} target="_blank" rel="noopener noreferrer" class="ct-maplink">Como chegar (Google Maps) →</a>

        <h2 class="ct-block-title ct-block-title--mt">Atendimento no WhatsApp</h2>
        <div class="ct-wa">
          {site.atendentes.map((a) => (
            <CtaWhatsApp variante="inline" atendente={a} mensagem={mensagens.generico} label={`Falar com ${a.nome}`} />
          ))}
        </div>

        {redes.length > 0 && (
          <>
            <h2 class="ct-block-title ct-block-title--mt">Redes sociais</h2>
            <ul class="ct-redes">
              {redes.map((r) => (<li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.nome}</a></li>))}
            </ul>
          </>
        )}
      </div>

      <div class="ct-map">
        <div class="map-wrap">
          <iframe
            title={`Localização da ${site.nome} em Goiânia`}
            src={mapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section--alt">
      <div class="container-site container-narrow">
        <FaqSection faqs={faqs} title="Perguntas frequentes" />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .crumbs-wrap { padding-block: 1.1rem 0; }
  .ct-hero { padding-block: clamp(2rem, 5vw, 3rem); }
  .ct-hero__title { font-size: clamp(2rem, 5.5vw, 3rem); font-weight: 800; }
  .ct-hero__lead { margin-top: 1rem; color: var(--color-ink-soft); font-size: 1.1rem; max-width: 52ch; }

  .section { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .section--alt { background: var(--color-paper-soft); }
  .container-narrow { max-width: 820px; }

  .ct-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: start; }
  @media (min-width: 860px) { .ct-grid { grid-template-columns: 0.9fr 1.1fr; } }

  .ct-block-title { font-size: 1.2rem; margin-bottom: 0.8rem; }
  .ct-block-title--mt { margin-top: 2rem; }
  .nap { font-style: normal; display: grid; gap: 0.35rem; color: var(--color-ink-soft); }
  .nap-nome { font-weight: 700; color: var(--color-apice-blue); }
  .ct-maplink { display: inline-block; margin-top: 0.85rem; font-weight: 700; color: var(--color-apice-blue); }
  .ct-maplink:hover { text-decoration: underline; }
  .ct-wa { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .ct-redes { list-style: none; padding: 0; margin: 0; display: flex; gap: 1.25rem; }
  .ct-redes a { font-weight: 700; color: var(--color-apice-blue); }
  .ct-redes a:hover { text-decoration: underline; }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-card);
  }
  .map-wrap iframe { display: block; width: 100%; height: 460px; border: 0; }
</style>
