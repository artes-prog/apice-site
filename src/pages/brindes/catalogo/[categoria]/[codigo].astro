---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CtaWhatsApp from '../../../../components/CtaWhatsApp.astro';
import BotaoOrcamento from '../../../../components/BotaoOrcamento.astro';
import CtaFinal from '../../../../components/CtaFinal.astro';
import Foto from '../../../../components/Foto.astro';
import { getImage } from 'astro:assets';
import { getCatalogoUnificado, urlImagemXbz, codigoSlug } from '../../../../lib/content';
import type { CategoriaCatalogo, ProdutoCatalogo } from '../../../../lib/content';
import { mensagens } from '../../../../lib/whatsapp';

export const getStaticPaths = (async () => {
  const categorias = await getCatalogoUnificado();
  const paths = [];
  for (const cat of categorias) {
    for (const produto of cat.produtos) {
      paths.push({
        params: { categoria: cat.slug, codigo: codigoSlug(produto.codigo) },
        props: { categoria: cat, produto },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { categoria, produto } = Astro.props as { categoria: CategoriaCatalogo; produto: ProdutoCatalogo };

/*
  URLs finais das fotos, iguais para as duas fontes — assim a galeria (que troca
  a foto principal pelo `src` guardado em data-foto) funciona sem saber a origem.
    XBZ      -> hotlink no servidor deles.
    Própria  -> arquivo local, otimizado no build pelo astro:assets.
  Se o produto do catálogo próprio ainda não tem foto (caso dos bottons recém
  cadastrados), a lista fica vazia e a página cai no placeholder padrão do site.
*/
const modulosImg = import.meta.glob<ImageMetadata>(
  '/src/assets/img/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true, import: 'default' }
);

let urlsFotos: string[] = [];
if (produto.fonte === 'xbz') {
  const brutas = produto.fotos.length > 0 ? produto.fotos : [produto.imagem];
  urlsFotos = brutas.filter(Boolean).map(urlImagemXbz);
} else {
  for (const caminho of produto.fotos) {
    const mod = modulosImg[`/src/assets/img/${caminho.replace(/^\/+/, '')}`];
    if (!mod) continue; // foto cadastrada mas arquivo ainda não enviado
    urlsFotos.push((await getImage({ src: mod, width: 700, format: 'webp' })).src);
  }
}
const temFoto = urlsFotos.length > 0;
const msg = mensagens.produto(`${produto.nome} (código ${produto.codigo})`);

/*
  Nota de personalização: cada categoria tem a sua técnica (botons e pins não são
  personalizados como canecas), então o texto vem da categoria, editável no CMS.
  Categoria própria manda no texto — inclusive deixar vazio, que esconde a nota.
  Categoria XBZ não é editável no CMS e cai na nota padrão do site.
*/
const NOTA_PADRAO =
  'Personalizamos este item com Silk Screen ou gravação a Fiber Laser, conforme o material. ' +
  'Fale com a gente pelo código para confirmar técnica, prazo e quantidade.';
const notaPersonalizacao =
  categoria.fonte === 'propria' ? categoria.notaPersonalizacao : NOTA_PADRAO;

const title = `${produto.nome} — Código ${produto.codigo} | Ápice Brindes`;
const description = `${produto.nome} do catálogo completo Ápice Brindes. Código ${produto.codigo}. Peça orçamento e personalização no WhatsApp.`;
---
<BaseLayout title={title} description={description} waMensagem={msg} waSemente={`produto-${produto.codigo}`}>
  <div class="container-site crumbs-wrap">
    <Breadcrumbs items={[
      { name: 'Início', href: '/' },
      { name: 'Brindes', href: '/brindes-personalizados/' },
      { name: 'Catálogo completo', href: '/brindes/catalogo/' },
      { name: categoria.nome, href: `/brindes/catalogo/${categoria.slug}/` },
      { name: produto.nome },
    ]} />
  </div>

  <section class="section">
    <div class="container-site produto-grid">
      <div class="produto-fotos">
        <div class="produto-foto-principal">
          {temFoto ? (
            <img id="foto-principal" src={urlsFotos[0]} alt={produto.nome} width="600" height="600" />
          ) : (
            /* Produto sem foto ainda: mesmo placeholder do resto do site. */
            <Foto src="" alt={produto.nome} ratio="1/1" priority widthHint={700} />
          )}
        </div>
        {urlsFotos.length > 1 && (
          <div class="produto-foto-miniaturas" id="foto-galeria">
            {urlsFotos.map((u, i) => (
              <button type="button" class="miniatura" class:list={{ 'is-ativa': i === 0 }} data-foto={u}>
                <img src={u} alt={`${produto.nome} — foto ${i + 1}`} width="90" height="90" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="produto-info">
        <p class="produto-codigo">Código: {produto.codigo}</p>
        <h1 class="produto-nome">{produto.nome}</h1>

        {produto.descricao && <p class="produto-descricao">{produto.descricao}</p>}

        {produto.especificacoes && produto.especificacoes.length > 0 && (
          <dl class="produto-specs">
            {produto.especificacoes.map((e) => (
              <>
                <dt>{e.label}</dt>
                <dd>{e.valor}</dd>
              </>
            ))}
          </dl>
        )}

        {produto.variacoes.length > 0 && (
          <div class="produto-bloco">
            <p class="produto-bloco__rot">Tamanhos disponíveis</p>
            <div class="produto-tags">
              {produto.variacoes.map((v) => <span class="produto-tag produto-tag--var">{v}</span>)}
            </div>
          </div>
        )}

        {produto.cores.length > 0 && (
          <div class="produto-bloco">
            <p class="produto-bloco__rot">Cores</p>
            <div class="produto-tags">
              {produto.cores.map((c) => <span class="produto-tag produto-tag--var">{c}</span>)}
            </div>
          </div>
        )}

        {produto.subcategoria && (
          <div class="produto-tags produto-tags--sub">
            <span class="produto-tag">{produto.subcategoria}</span>
          </div>
        )}

        {produto.tags && produto.tags.length > 0 && (
          <div class="produto-tags">
            {produto.tags.map((t) => <span class="produto-tag">{t.nome}</span>)}
          </div>
        )}

        {notaPersonalizacao && <p class="produto-nota">{notaPersonalizacao}</p>}

        <div class="produto-acoes">
          <CtaWhatsApp variante="primario" mensagem={msg} semente={`produto-${produto.codigo}`} label="Pedir orçamento deste produto" />
          <BotaoOrcamento
            codigo={produto.codigo}
            nome={produto.nome}
            url={`/brindes/catalogo/${categoria.slug}/${codigoSlug(produto.codigo)}/`}
          />
        </div>
        <p class="produto-dica">Vai pedir mais de um item? Adicione à lista e mande tudo numa mensagem só.</p>

        <a href={`/brindes/catalogo/${categoria.slug}/`} class="produto-voltar">← Voltar para {categoria.nome}</a>
      </div>
    </div>
  </section>

  <CtaFinal semente={`produto-${produto.codigo}`} mensagem={msg} titulo="Quer ver mais opções antes de decidir?" />
</BaseLayout>

<script>
  /*
    Igual ao catálogo: com <ClientRouter /> este módulo não re-executa a cada navegação, então
    ligar os listeners no escopo do módulo deixaria as miniaturas mortas ao abrir o 2º produto
    pelo link. Montagem via `astro:page-load` + guard para não ligar duas vezes no mesmo DOM.
  */
  function initGaleria() {
    const galeria = document.getElementById('foto-galeria');
    const principal = document.getElementById('foto-principal') as HTMLImageElement | null;
    if (!galeria || !principal) return;
    if (galeria.dataset.wired) return;
    galeria.dataset.wired = '1';

    galeria.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.miniatura');
      if (!btn) return;
      principal.src = btn.dataset.foto ?? principal.src;
      galeria.querySelectorAll('.miniatura').forEach((b) => b.classList.remove('is-ativa'));
      btn.classList.add('is-ativa');
    });
  }

  document.addEventListener('astro:page-load', initGaleria);
</script>

<style>
  .crumbs-wrap { padding-block: 1.1rem 0; }
  .section { padding-block: clamp(1.5rem, 4vw, 3rem); }

  .produto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 860px) {
    .produto-grid { grid-template-columns: 1fr 1fr; align-items: start; }
  }

  .produto-foto-principal {
    aspect-ratio: 1/1;
    background: var(--color-paper-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .produto-foto-principal img { width: 100%; height: 100%; object-fit: contain; }

  .produto-foto-miniaturas { display: flex; gap: 0.6rem; margin-top: 0.75rem; flex-wrap: wrap; }
  .miniatura {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    border: 2px solid var(--color-line);
    overflow: hidden;
    padding: 0;
    background: var(--color-paper-soft);
    cursor: pointer;
  }
  .miniatura img { width: 100%; height: 100%; object-fit: contain; }
  .miniatura.is-ativa { border-color: var(--color-apice-blue); }

  .produto-codigo { color: var(--color-ink-soft); font-size: 0.9rem; font-weight: 600; }
  .produto-nome { font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 800; margin-top: 0.3rem; }
  .produto-descricao { margin-top: 1rem; color: var(--color-ink-soft); line-height: 1.7; }

  .produto-specs {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    font-size: 0.92rem;
  }
  .produto-specs dt { font-weight: 700; color: var(--color-apice-blue); }
  .produto-specs dd { color: var(--color-ink-soft); }

  .produto-bloco { margin-top: 1.25rem; }
  .produto-bloco__rot {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin-bottom: 0.5rem;
  }
  .produto-bloco .produto-tags { margin-top: 0; }
  .produto-tag--var {
    color: var(--color-apice-blue);
    background: color-mix(in srgb, var(--color-apice-blue) 8%, transparent);
    border-color: color-mix(in srgb, var(--color-apice-blue) 25%, transparent);
  }
  .produto-tags--sub { margin-top: 1rem; }

  .produto-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .produto-tag {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.8rem;
    background: var(--color-paper-soft);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-soft);
  }

  .produto-nota { margin-top: 1.25rem; color: var(--color-ink-soft); font-size: 0.92rem; max-width: 60ch; }

  .produto-info :global(.wa) { margin-top: 1.5rem; }
  .produto-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .produto-dica { margin-top: 0.7rem; color: var(--color-ink-soft); font-size: 0.87rem; }

  .produto-voltar { display: block; margin-top: 1.25rem; color: var(--color-apice-blue); font-weight: 600; font-size: 0.92rem; }
</style>
