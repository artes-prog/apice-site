---
import { getEntry } from 'astro:content';
import TecnicaPage from '../layouts/TecnicaPage.astro';

const entry = await getEntry('tecnicas', 'silk-screen');
if (!entry) throw new Error('Conteúdo da técnica "silk-screen" não encontrado.');
---
<TecnicaPage entry={entry} serviceType="Impressão Silk Screen em brindes" />
