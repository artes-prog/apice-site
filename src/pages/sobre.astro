---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Foto from '../components/Foto.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { mensagens } from '../lib/whatsapp';

const diferenciais = [
  { titulo: 'Produção própria', texto: 'Silk screen e gravação a laser fibra na nossa fábrica em Goiânia. Não terceirizamos o que é o coração do serviço.' },
  { titulo: 'Prazo que a gente controla', texto: 'Sem depender de terceiros, entregamos prazos reais — e cumprimos. Especialmente importante quando há data de evento.' },
  { titulo: 'Qualidade peça a peça', texto: 'Conferência item a item e cura correta da tinta no silk. É o que separa um brinde que dura de um que descasca.' },
  { titulo: 'Atendimento próximo', texto: 'Você fala com gente de verdade no WhatsApp, aprova a prova digital e acompanha o pedido sem burocracia.' },
];

const title = 'Sobre a Ápice Brindes — Produção Própria em Goiânia';
const description =
  'Conheça a Ápice Brindes: mais de 20 anos personalizando brindes em Goiânia com produção própria de silk screen e gravação a laser. Parte do Grupo Uaibag.';
---
<BaseLayout title={title} description={description} waMensagem={mensagens.generico} waSemente="sobre">
  <div class="container-site crumbs-wrap">
    <Breadcrumbs items={[{ name: 'Início', href: '/' }, { name: 'Sobre' }]} />
  </div>

  <section class="sobre-hero">
    <div class="container-site sobre-hero__grid">
      <div>
        <h1 class="sobre-hero__title">Brindes que a gente produz — não que a gente revende</h1>
        <p class="sobre-hero__lead">
          A Ápice Brindes nasceu para resolver uma dor comum de quem compra brinde corporativo: prazo furado e
          qualidade que não chega. Há <strong>{site.anosDeMercado.toLowerCase()}</strong> fazemos diferente, com
          <strong> produção própria</strong> de silk screen e gravação a laser fibra em Goiânia.
        </p>
      </div>
      <div class="sobre-hero__media">
        <Foto src="sobre/producao.jpg" alt="Produção própria de brindes personalizados da Ápice em Goiânia" ratio="4/3" priority widthHint={900} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site container-narrow prose-block">
      <h2>Parte do Grupo Uaibag</h2>
      <p>
        Somos parte do <strong>{site.grupo}</strong>. Essa origem na confecção é uma vantagem concreta para o
        cliente: unimos a experiência têxtil do grupo — camisetas, uniformes e vestuário — com a personalização
        de brindes em silk e laser. Na prática, é um fornecedor só resolvendo do kit de boas-vindas ao uniforme
        do time, com o mesmo padrão de acabamento.
      </p>
      <h2>Como trabalhamos</h2>
      <p>
        Atendemos empresas, RHs, agências, comitês de formatura e comércio de Goiânia e região. Você nos diz o
        que precisa (ou pede sugestão por faixa de investimento), aprova a prova digital, e a gente produz e
        entrega. Nada de catálogo interminável ou processo confuso: o caminho é direto e o atendimento é humano.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container-site">
      <h2 class="section__title section__title--center">O que nos torna diferentes</h2>
      <div class="dif-grid">
        {diferenciais.map((d) => (
          <div class="dif-card">
            <h3>{d.titulo}</h3>
            <p>{d.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaFinal semente="sobre" mensagem={mensagens.generico} />
</BaseLayout>

<style>
  .crumbs-wrap { padding-block: 1.1rem 0; }
  .sobre-hero { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .sobre-hero__grid { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }
  .sobre-hero__title { font-size: clamp(1.9rem, 5vw, 2.9rem); font-weight: 800; }
  .sobre-hero__lead { margin-top: 1.1rem; color: var(--color-ink-soft); font-size: 1.1rem; max-width: 52ch; }

  .section { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .section--alt { background: var(--color-paper-soft); }
  .section__title { font-size: clamp(1.5rem, 4vw, 2.1rem); }
  .section__title--center { text-align: center; margin-bottom: 2rem; }
  .container-narrow { max-width: 780px; }

  .prose-block h2 { font-size: clamp(1.4rem, 3.5vw, 1.85rem); margin: 2rem 0 0.75rem; }
  .prose-block h2:first-child { margin-top: 0; }
  .prose-block p { color: var(--color-ink-soft); line-height: 1.75; margin-bottom: 1rem; }

  .dif-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 620px) { .dif-grid { grid-template-columns: repeat(2, 1fr); } }
  .dif-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-apice-red);
    border-radius: var(--radius-card);
    padding: 1.4rem 1.5rem;
    box-shadow: var(--shadow-card);
  }
  .dif-card h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }
  .dif-card p { color: var(--color-ink-soft); }

  @media (min-width: 860px) {
    .sobre-hero__grid { grid-template-columns: 1.05fr 0.95fr; }
  }
</style>
