---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Foto from '../components/Foto.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductGrid from '../components/ProductGrid.astro';
import TrustBar from '../components/TrustBar.astro';
import Steps from '../components/Steps.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { site } from '../data/site';
import { mensagens } from '../lib/whatsapp';
import {
  getCategoriasDestaque,
  getFaqsDaPagina,
  getDepoimentosPublicados,
} from '../lib/content';

const categoriasDestaque = await getCategoriasDestaque();
const faqs = await getFaqsDaPagina('home');
const depoimentos = await getDepoimentosPublicados();

const todosProdutos = await getCollection('produtos');
const maisPedidos = todosProdutos.filter((p) => p.data.maisPedido).slice(0, 6);

const title = 'Brindes Personalizados em Goiânia | Ápice Brindes';
const description =
  'Brindes personalizados para empresas em Goiânia com produção própria de Silk Screen e gravação com Fiber Laser. Canecas, garrafas, kits e mais. Orçamento rápido no WhatsApp.';
---
<BaseLayout title={title} description={description} waMensagem={mensagens.home} waSemente="home">
  <!-- HERO -->
  <section class="hero">
    <div class="container-site hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">Silk Screen e gravação com Fiber Laser — feitos por nós</p>
        <h1 class="hero__title">Brindes personalizados que marcam a sua empresa em Goiânia</h1>
        <p class="hero__lead">
          Canecas, garrafas, canetas, copos e kits corporativos com o seu logo. Produção própria há
          {' '}{site.anosDeMercado.toLowerCase()}: prazo real, qualidade controlada peça a peça e orçamento
          rápido no WhatsApp.
        </p>
        <div class="hero__ctas">
          <CtaWhatsApp variante="primario" mensagem={mensagens.home} semente="home" label="Pedir orçamento no WhatsApp" />
          <a href="/brindes-personalizados/" class="hero__link">Ver categorias de brindes</a>
        </div>
      </div>
      <div class="hero__media">
        <Foto src="home/hero.jpg" alt="Brindes corporativos personalizados pela Ápice Brindes em Goiânia" ratio="4/3" priority widthHint={960} />
      </div>
    </div>
  </section>

  <TrustBar />

  <!-- CATEGORIAS -->
  <section class="section">
    <div class="container-site">
      <div class="section__head">
        <div>
          <h2 class="section__title">Categorias de brindes</h2>
          <p class="section__sub">Do clássico ao premium — tudo personalizável com a sua marca.</p>
        </div>
        <a href="/brindes-personalizados/" class="section__more">Ver todas →</a>
      </div>
      <div class="cards-grid">
        {categoriasDestaque.map((c, i) => (
          <CategoryCard
            nome={c.data.nome}
            slug={c.data.slug}
            imagemCapa={c.data.imagemCapa}
            tecnicas={c.data.tecnicas}
            priority={i < 3}
          />
        ))}
      </div>
    </div>
  </section>

  <Steps />

  <!-- TÉCNICAS (prova de produção própria) -->
  <section class="section section--alt">
    <div class="container-site">
      <h2 class="section__title section__title--center">Produção própria: a diferença que você sente na peça</h2>
      <p class="section__sub section__sub--center">
        A maioria terceiriza. Nós fazemos Silk Screen e gravação com Fiber Laser aqui em Goiânia — por isso o
        prazo é real e o acabamento não desbota.
      </p>
      <div class="tec-grid">
        <a href="/gravacao-a-laser/" class="tec-card">
          <Foto src="tecnicas/laser-hero.jpg" alt="Gravação com Fiber Laser em garrafa de inox personalizada" ratio="16/9" />
          <div class="tec-card__body">
            <h3>Gravação com Fiber Laser</h3>
            <p>Marcação permanente em inox, alumínio e couro. Acabamento executivo que não sai nunca.</p>
            <span class="tec-card__link">Conhecer a técnica →</span>
          </div>
        </a>
        <a href="/silk-screen/" class="tec-card">
          <Foto src="tecnicas/silk-hero.jpg" alt="Impressão Silk Screen em caneca de cerâmica personalizada" ratio="16/9" />
          <div class="tec-card__body">
            <h3>Silk Screen</h3>
            <p>Cores vivas e fiéis à sua marca em cerâmica, plástico, vidro e tecido. Cura correta, sem craquelar.</p>
            <span class="tec-card__link">Conhecer a técnica →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- MAIS PEDIDOS -->
  {maisPedidos.length > 0 && (
    <section class="section">
      <div class="container-site">
        <div class="section__head">
          <div>
            <h2 class="section__title">Os mais pedidos</h2>
            <p class="section__sub">Campeões de venda para ações corporativas.</p>
          </div>
        </div>
        <ProductGrid produtos={maisPedidos} />
      </div>
    </section>
  )}

  <!-- DEPOIMENTOS (só se houver publicados) -->
  {depoimentos.length > 0 && (
    <section class="section section--alt">
      <div class="container-site">
        <h2 class="section__title section__title--center">O que dizem nossos clientes</h2>
        <p class="depo-sub">Avaliações públicas de quem já comprou com a gente.</p>
        <div class="cards-grid cards-grid--3">
          {depoimentos.slice(0, 6).map((d) => (
            <TestimonialCard
              texto={d.data.texto}
              autor={d.data.autor}
              empresa={d.data.empresa}
              fonte={d.data.fonte}
              estrelas={d.data.estrelas}
            />
          ))}
        </div>
        {site.googleBusiness && (
          <p class="depo-todas">
            <a href={site.googleBusiness} target="_blank" rel="noopener noreferrer">
              Ver todas as avaliações no Google →
            </a>
          </p>
        )}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faqs.length > 0 && (
    <section class="section">
      <div class="container-site container-narrow">
        <FaqSection faqs={faqs} title="Dúvidas frequentes" />
      </div>
    </section>
  )}

  <!-- INSTAGRAM -->
  {site.instagram && (
    <section class="section instagram-section">
      <div class="container-site instagram-card">
        <svg class="instagram-card__icon" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
          <path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.2A6.6 6.6 0 1 0 12 18.6 6.6 6.6 0 0 0 12 5.4zm0 10.9A4.3 4.3 0 1 1 12 7.7a4.3 4.3 0 0 1 0 8.6zm6.8-11.2a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
        </svg>
        <p class="instagram-card__eyebrow">Acompanhe a Ápice no Instagram</p>
        <p class="instagram-card__texto">Acompanhe nossos últimos projetos, lançamentos e ideias de brindes personalizados no <strong>@apicebrindes</strong>.</p>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="instagram-card__botao"
          data-instagram
          data-origem="home_instagram_section"
        >
          Seguir no Instagram
        </a>
      </div>
    </section>
  )}

  <CtaFinal semente="home" mensagem={mensagens.home} />
</BaseLayout>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: center;
  }
  .hero__eyebrow {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--color-apice-red);
    margin-bottom: 0.75rem;
  }
  .hero__title { font-size: clamp(2rem, 5.5vw, 3.1rem); font-weight: 800; }
  .hero__lead { margin-top: 1.1rem; font-size: 1.1rem; color: var(--color-ink-soft); max-width: 46ch; }
  .hero__ctas {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.4rem;
  }
  .hero__link { font-weight: 700; color: var(--color-apice-blue); border-bottom: 2px solid transparent; }
  .hero__link:hover { border-color: var(--color-apice-blue); }

  .section { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .section--alt { background: var(--color-paper-soft); }
  .section__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 1.75rem;
  }
  .section__title { font-size: clamp(1.5rem, 4vw, 2.2rem); }
  .section__title--center { text-align: center; }
  .section__sub { color: var(--color-ink-soft); margin-top: 0.35rem; }
  .section__sub--center { text-align: center; max-width: 60ch; margin-inline: auto; margin-bottom: 2rem; }
  .section__more { font-weight: 700; color: var(--color-apice-blue); white-space: nowrap; }
  .section__more:hover { text-decoration: underline; }

  .depo-sub {
    text-align: center;
    color: var(--color-ink-soft);
    margin: 0.4rem auto 2rem;
    max-width: 52ch;
  }
  .depo-todas { text-align: center; margin-top: 1.75rem; }
  .depo-todas a { font-weight: 700; color: var(--color-apice-blue); }
  .depo-todas a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 560px) { .cards-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .cards-grid { grid-template-columns: repeat(3, 1fr); } }
  .cards-grid--3 { grid-template-columns: 1fr; }
  @media (min-width: 860px) { .cards-grid--3 { grid-template-columns: repeat(3, 1fr); } }

  .container-narrow { max-width: 820px; }

  .tec-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 760px) { .tec-grid { grid-template-columns: repeat(2, 1fr); } }
  .tec-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .tec-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }
  .tec-card :global(.foto) { border-radius: 0; }
  .tec-card__body { padding: 1.35rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .tec-card__body h3 { font-size: 1.3rem; }
  .tec-card__body p { color: var(--color-ink-soft); }
  .tec-card__link { font-weight: 700; color: var(--color-apice-blue); margin-top: 0.25rem; }

  @media (min-width: 860px) {
    .hero__grid { grid-template-columns: 1.05fr 0.95fr; }
  }

  /* Instagram: card discreto, sem virar banner — mesma lógica de "botão
     pílula centralizado" já usada no catálogo (CatalogoBanner). */
  .instagram-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .instagram-card__icon { color: var(--color-apice-blue); }
  .instagram-card__eyebrow {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .instagram-card__texto { color: var(--color-ink-soft); max-width: 46ch; }
  .instagram-card__botao {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    background: var(--color-apice-blue);
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .instagram-card__botao:hover {
    background: var(--color-apice-blue-dark);
    transform: translateY(-2px);
  }
</style>
