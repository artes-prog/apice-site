---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Foto from '../../components/Foto.astro';
import CtaWhatsApp from '../../components/CtaWhatsApp.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import {
  getPostsPublicados,
  getCategorias,
  getFaqsPorSlugs,
  dataPorExtenso,
} from '../../lib/content';
import { mensagens } from '../../lib/whatsapp';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const posts = await getPostsPublicados();
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

// Links internos: categorias citadas pelo post (SEO + caminho para a conversão).
const todasCategorias = await getCategorias();
const relacionadas = todasCategorias.filter((c) => d.categoriasRelacionadas.includes(c.data.slug));
const faqs = await getFaqsPorSlugs(d.faqSlugs);

const msg = mensagens.generico;
const urlCanonica = new URL(`/blog/${d.slug}/`, Astro.site).toString();

/*
  BlogPosting no JSON-LD: é o que faz o Google entender que a página é um
  artigo (com autor, data e veículo), em vez de mais uma página institucional.
*/
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.titulo,
  description: d.resumo,
  datePublished: d.publicadoEm.toISOString(),
  dateModified: (d.atualizadoEm ?? d.publicadoEm).toISOString(),
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': urlCanonica },
  author: { '@type': 'Organization', name: site.nome, url: new URL('/', Astro.site).toString() },
  publisher: {
    '@type': 'Organization',
    name: site.nome,
    logo: { '@type': 'ImageObject', url: new URL('/og-default.png', Astro.site).toString() },
  },
};
---
<BaseLayout title={d.tituloSeo} description={d.descricaoSeo} ogType="article" waMensagem={msg} waSemente={`blog-${d.slug}`}>
  <div class="container-site crumbs-wrap">
    <Breadcrumbs items={[
      { name: 'Início', href: '/' },
      { name: 'Blog', href: '/blog/' },
      { name: d.titulo },
    ]} />
  </div>

  <article class="post">
    <header class="container-site post__head">
      <h1 class="post__titulo">{d.titulo}</h1>
      <p class="post__resumo">{d.resumo}</p>
      <p class="post__meta">
        <time datetime={d.publicadoEm.toISOString()}>Publicado em {dataPorExtenso(d.publicadoEm)}</time>
        {d.atualizadoEm && <span> · Atualizado em {dataPorExtenso(d.atualizadoEm)}</span>}
      </p>
    </header>

    <div class="container-site post__capa">
      <Foto src={d.imagemCapa} alt={d.titulo} ratio="16/9" priority widthHint={1100} />
    </div>

    <div class="container-site post__corpo">
      <Content />

      <aside class="post__cta">
        <p class="post__cta-txt">Quer ajuda para escolher os brindes da sua empresa?</p>
        <CtaWhatsApp variante="primario" mensagem={msg} semente={`blog-${d.slug}`} label="Falar com a nossa equipe" />
      </aside>
    </div>
  </article>

  {relacionadas.length > 0 && (
    <section class="section section--alt">
      <div class="container-site">
        <h2 class="section__titulo">Categorias citadas neste guia</h2>
        <div class="rel-grid">
          {relacionadas.map((c) => (
            <CategoryCard nome={c.data.nome} slug={c.data.slug} imagemCapa={c.data.imagemCapa} tecnicas={c.data.tecnicas} />
          ))}
        </div>
      </div>
    </section>
  )}

  {faqs.length > 0 && (
    <section class="section">
      <div class="container-site container-narrow">
        <FaqSection faqs={faqs} title="Perguntas frequentes sobre isso" />
      </div>
    </section>
  )}

  <CtaFinal semente={`blog-${d.slug}`} mensagem={msg} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</BaseLayout>

<style>
  .crumbs-wrap { padding-block: 1.1rem 0; }
  .post__head { padding-block: clamp(1.2rem, 3vw, 2rem) 1.25rem; max-width: 780px; }
  .post__titulo { font-size: clamp(1.75rem, 4.6vw, 2.6rem); font-weight: 800; line-height: 1.18; text-wrap: balance; }
  .post__resumo { margin-top: 0.9rem; font-size: 1.1rem; color: var(--color-ink-soft); line-height: 1.6; }
  .post__meta { margin-top: 0.9rem; font-size: 0.85rem; color: var(--color-ink-soft); }

  .post__capa { max-width: 900px; }
  .post__capa :global(.foto) { border-radius: var(--radius-lg); }

  /* Coluna de leitura estreita: ~70 caracteres por linha é o conforto ideal */
  .post__corpo { max-width: 720px; padding-block: clamp(1.5rem, 4vw, 2.5rem); }
  .post__corpo :global(h2) {
    font-size: clamp(1.35rem, 3.2vw, 1.7rem);
    margin-top: 2.4rem;
    margin-bottom: 0.85rem;
    color: var(--color-apice-blue);
    text-wrap: balance;
  }
  .post__corpo :global(h3) { font-size: 1.12rem; margin-top: 1.8rem; margin-bottom: 0.6rem; }
  .post__corpo :global(p) { margin-bottom: 1.1rem; line-height: 1.75; }
  .post__corpo :global(ul),
  .post__corpo :global(ol) { margin: 0 0 1.3rem 1.2rem; display: grid; gap: 0.5rem; }
  .post__corpo :global(li) { line-height: 1.65; }
  .post__corpo :global(strong) { color: var(--color-ink); font-weight: 700; }
  .post__corpo :global(a) { color: var(--color-apice-blue); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .post__corpo :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.9rem 1.2rem;
    border-left: 4px solid var(--color-apice-red);
    background: var(--color-paper-soft);
    border-radius: 0 8px 8px 0;
    color: var(--color-ink-soft);
  }
  /* Tabelas largas rolam sozinhas, sem empurrar a página de lado */
  .post__corpo :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4rem 0;
    font-size: 0.94rem;
    display: block;
    overflow-x: auto;
  }
  .post__corpo :global(th),
  .post__corpo :global(td) { border: 1px solid var(--color-line); padding: 0.6rem 0.8rem; text-align: left; }
  .post__corpo :global(th) { background: var(--color-paper-soft); font-weight: 700; }

  .post__cta {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--color-paper-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .post__cta-txt { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; margin-bottom: 1rem; }

  .section { padding-block: clamp(2rem, 4vw, 3rem); }
  .section--alt { background: var(--color-paper-soft); }
  .section__titulo { font-size: clamp(1.35rem, 3.4vw, 1.9rem); margin-bottom: 1.5rem; }
  .container-narrow { max-width: 820px; }

  .rel-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 620px) { .rel-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .rel-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
