---
import '../styles/global.css';
// Fontes self-hosted (font-display: swap embutido). Só 2 famílias, 2 pesos cada,
// subset latin (suficiente para o português) — payload mínimo para o CWV.
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-600.css';

import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import OrcamentoFlutuante from '../components/OrcamentoFlutuante.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import LocalBusinessJsonLd from '../components/seo/LocalBusinessJsonLd.astro';
import { getCategorias } from '../lib/content';
import { mensagens } from '../lib/whatsapp';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  waMensagem?: string;
  waSemente?: string;
}
const {
  title,
  description,
  image,
  ogType,
  noindex,
  waMensagem = mensagens.generico,
  waSemente,
} = Astro.props;

const categoriasRaw = await getCategorias();
const categorias = categoriasRaw.map((c) => ({ nome: c.data.nome, slug: c.data.slug }));
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#1541A8" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead title={title} description={description} image={image} ogType={ogType} noindex={noindex} />
    <LocalBusinessJsonLd />

    <!-- Google tag (gtag.js) — GA4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZJ3QG3PYN1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      /*
        send_page_view:false + page_view manual no 'astro:page-load'.
        Motivo: o site usa <ClientRouter /> (view transitions). Navegar por link
        NÃO recarrega a página, então o page_view automático do GA4 dispararia
        só na primeira página da visita e o resto da navegação sumiria do
        relatório. O evento 'astro:page-load' dispara na carga inicial E em cada
        transição — 1 page_view por página, sem duplicar.
      */
      gtag('config', 'G-ZJ3QG3PYN1', { send_page_view: false });

      document.addEventListener('astro:page-load', function () {
        gtag('event', 'page_view', {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname + window.location.search,
        });
      });
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer categorias={categorias} />

    <!-- CTA flutuante: presente em todas as páginas -->
    <CtaWhatsApp variante="flutuante" mensagem={waMensagem} semente={waSemente} />
    <OrcamentoFlutuante />

    <script>
      import { ler, linhasDaMensagem } from '../lib/lista-orcamento';

      /*
        ---- Captura de lead ----
        O site é estático (sem servidor), então guardar o contato exige um
        endpoint externo. Enquanto LEAD_ENDPOINT estiver vazio, a função é um
        no-op silencioso: o formulário segue funcionando normalmente pelo
        WhatsApp, sem erro nenhum para o visitante.

        Para ligar: cole a URL do formulário (ex.: Web3Forms/Formspree) em
        LEAD_ENDPOINT. A partir daí, todo envio é registrado ANTES de abrir o
        WhatsApp — inclusive de quem desiste no meio, que hoje se perde.
      */
      const LEAD_ENDPOINT = '';

      function enviarLead(dados: Record<string, unknown>) {
        if (!LEAD_ENDPOINT) return;
        try {
          const corpo = JSON.stringify({ ...dados, enviado_em: new Date().toISOString() });
          // keepalive: a requisição sobrevive à aba navegando para o WhatsApp.
          fetch(LEAD_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: corpo,
            keepalive: true,
          }).catch(() => {});
        } catch (_) {
          /* nunca bloquear o envio pelo WhatsApp por causa da captura */
        }
      }

      // Ilha única de interatividade: menu mobile + medição de cliques de CTA.
      // Delegação em `document` (persiste entre view transitions do ClientRouter).
      const closeMenu = () => {
        const menu = document.getElementById('mobile-menu');
        const btn = document.querySelector('[data-menu-toggle]');
        if (menu) (menu as HTMLElement).hidden = true;
        if (btn) btn.setAttribute('aria-expanded', 'false');
      };

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        const toggle = target.closest('[data-menu-toggle]');
        if (toggle) {
          const menu = document.getElementById('mobile-menu') as HTMLElement | null;
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!isOpen));
          toggle.setAttribute('aria-label', isOpen ? 'Abrir menu de navegação' : 'Fechar menu de navegação');
          if (menu) menu.hidden = isOpen;
          return;
        }

        if (target.closest('[data-menu-close]')) {
          closeMenu();
          // deixa a navegação seguir normalmente
        }

        const wa = target.closest('[data-wa]') as HTMLElement | null;
        if (wa) {
          const pagina = wa.getAttribute('data-pagina') || location.pathname;
          const atendente = wa.getAttribute('data-atendente') || '';
          const label = `${pagina}-${atendente}`;
          // Dispara evento se houver analytics (Plausible/GA). No-op sem eles.
          // Para ativar: adicione o snippet do Plausible OU Cloudflare Web Analytics.
          try {
            (window as any).plausible?.('WhatsApp', { props: { pagina, atendente, label } });
            (window as any).gtag?.('event', 'whatsapp_click', { pagina, atendente });
          } catch (_) {}
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      // ---- Construtor de orçamento (/orcamento/) ----
      // Monta a mensagem completa e abre o WhatsApp da atendente do dia (par/ímpar).
      function wireOrcamento() {
        const form = document.getElementById('orcamento-form') as HTMLFormElement | null;
        if (!form || form.dataset.wired) return;
        form.dataset.wired = '1';
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const val = (n: string) =>
            ((form.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();
          const linhas = ['Olá! Vim pelo site da Ápice e quero um orçamento de brindes personalizados.', ''];
          const add = (rot: string, n: string) => { const v = val(n); if (v) linhas.push(`${rot}: ${v}`); };
          add('Nome', 'nome');
          add('Empresa', 'empresa');
          add('WhatsApp', 'whatsapp');
          add('E-mail', 'email');
          add('Categoria', 'categoria');
          add('Quantidade estimada', 'quantidade');
          add('Data do evento', 'data');
          add('Mensagem', 'mensagem');
          // Produtos separados no catálogo entram na mesma mensagem, com os códigos.
          linhas.push(...linhasDaMensagem());

          // Captura do lead ANTES de sair para o WhatsApp: se a pessoa não
          // concluir o envio lá, o contato não se perde. Só dispara quando um
          // endpoint estiver configurado (ver LEAD_ENDPOINT).
          enviarLead({
            nome: val('nome'),
            empresa: val('empresa'),
            whatsapp: val('whatsapp'),
            email: val('email'),
            categoria: val('categoria'),
            quantidade: val('quantidade'),
            data: val('data'),
            mensagem: val('mensagem'),
            produtos: ler().map((i) => `${i.nome} (${i.codigo})`).join(' | '),
            origem: location.pathname,
          });

          const wa1 = form.dataset.wa1 || '';
          const wa2 = form.dataset.wa2 || '';
          const numero = new Date().getDate() % 2 === 0 ? wa1 : wa2;
          const url = `https://wa.me/${numero}?text=${encodeURIComponent(linhas.join('\n'))}`;
          try {
            (window as any).plausible?.('WhatsApp', { props: { pagina: '/orcamento/', atendente: 'form' } });
            (window as any).gtag?.('event', 'gerar_lead', {
              tem_email: Boolean(val('email')),
              produtos_na_lista: ler().length,
            });
          } catch (_) {}
          const win = window.open(url, '_blank', 'noopener');
          if (!win) window.location.href = url;
        });
      }
      document.addEventListener('astro:page-load', wireOrcamento);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    z-index: 100;
    background: var(--color-apice-blue);
    color: #fff;
    padding: 0.75rem 1.25rem;
    border-radius: 0 0 8px 0;
    font-weight: 700;
  }
  .skip-link:focus {
    left: 0;
  }
</style>
