---
import { atendentePorSemente, linkWhatsApp } from '../lib/whatsapp';
import type { Atendente } from '../data/site';

/*
  O botão que o site inteiro existe para fazer o usuário clicar.
  Verde = EXCLUSIVO deste CTA (Guia de Estilo §1.2) — por isso é inconfundível.

  Props:
    mensagem  -> texto que já vai preenchido no WhatsApp (sempre contextual)
    atendente -> força uma atendente específica; se ausente, distribui por `semente`
    semente   -> base do sorteio determinístico (padrão: caminho da página)
    variante  -> 'primario' | 'inline' | 'flutuante'
    label     -> texto do botão (primario/inline)
*/
interface Props {
  mensagem: string;
  atendente?: Atendente;
  semente?: string;
  variante?: 'primario' | 'inline' | 'flutuante';
  label?: string;
  class?: string;
}
const {
  mensagem,
  atendente,
  semente,
  variante = 'primario',
  label = 'Pedir orçamento no WhatsApp',
  class: klass = '',
} = Astro.props;

const alvo = atendente ?? atendentePorSemente(semente ?? Astro.url.pathname);
const href = linkWhatsApp(alvo.whatsapp, mensagem);
const pagina = Astro.url.pathname;
const ariaLabel =
  variante === 'flutuante'
    ? `Pedir orçamento no WhatsApp com ${alvo.nome}`
    : `${label} (atendimento com ${alvo.nome})`;
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`wa wa--${variante} ${klass}`}
  aria-label={ariaLabel}
  data-wa
  data-pagina={pagina}
  data-atendente={alvo.nome}
>
  <svg class="wa__icon" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M16 3C9.4 3 4 8.3 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.6 1.4 5.6 1.4h.2c6.6 0 12-5.3 12-12S22.6 3 16 3zm0 21.8c-1.7 0-3.4-.5-4.9-1.3l-.4-.2-4.9 1 1-4.7-.3-.5C5.6 18.4 5 16.7 5 15 5 9.9 9.9 5.9 16 5.9S27 9.9 27 15s-4.9 9.8-11 9.8zm5.6-7.3c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1c-1.7-.8-2.8-1.5-3.9-3.4-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.8 1.2 3 2 3.1 4.9 4.3c1.8.8 2.5.9 3.4.7.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/>
  </svg>
  {variante !== 'flutuante' && <span class="wa__label">{label}</span>}
  {variante === 'flutuante' && <span class="wa__label wa__label--float">Orçamento no WhatsApp</span>}
</a>

<style>
  .wa {
    --wa: var(--color-wa-green);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    background: var(--wa);
    border-radius: 999px;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    text-align: center;
    line-height: 1.1;
  }
  .wa:hover {
    background: var(--color-wa-green-dark);
  }
  .wa__icon {
    flex: none;
  }

  /* Primário — CTA grande de herói/seções */
  .wa--primario {
    padding: 0.95rem 1.6rem;
    font-size: 1.05rem;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
  }
  .wa--primario:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(37, 211, 102, 0.4);
  }

  /* Inline — mais discreto, dentro de blocos de texto/cards */
  .wa--inline {
    padding: 0.6rem 1.1rem;
    font-size: 0.95rem;
  }

  /* Flutuante — presente em todas as páginas, canto inferior direito */
  .wa--flutuante {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    padding: 0.85rem 1.2rem;
    font-size: 0.95rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  }
  .wa--flutuante:hover {
    transform: translateY(-2px);
  }
  .wa__label--float {
    display: inline;
  }
  /* Em telas bem estreitas o flutuante vira só o ícone (não cobre conteúdo) */
  @media (max-width: 400px) {
    .wa--flutuante {
      padding: 0.9rem;
      border-radius: 999px;
    }
    .wa__label--float {
      display: none;
    }
  }
</style>
