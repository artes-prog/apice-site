---
import Foto from './Foto.astro';
import { nomeTecnica } from '../lib/content';

/*
  Card de categoria: foto 4:3, título curto, tags de técnica.
  O card inteiro é um link; hover eleva e desloca levemente (Guia §1.3).
*/
interface Props {
  nome: string;
  slug: string;
  imagemCapa: string;
  tecnicas: ('laser' | 'silk' | 'ambas' | 'sublimacao' | 'silk-sublimacao')[];
  priority?: boolean;
}
const { nome, slug, imagemCapa, tecnicas, priority = false } = Astro.props;
// "ambas" expande para silk+laser; outros valores (ex.: sublimacao) se somam,
// em vez de serem substituídos — uma categoria pode ter mais de duas técnicas.
const expandido = tecnicas.flatMap((t) => (t === 'ambas' ? ['silk', 'laser'] : [t]));
const tags = [...new Set(expandido)];
---
<a href={`/brindes/${slug}/`} class="cat-card" aria-label={`Ver ${nome}`}>
  <div class="cat-card__media">
    <Foto src={imagemCapa} alt={`${nome} personalizados pela Ápice Brindes em Goiânia`} ratio="4/3" priority={priority} />
  </div>
  <div class="cat-card__body">
    <h3 class="cat-card__title">{nome}</h3>
    <ul class="cat-card__tags" aria-label="Técnicas de personalização">
      {tags.map((t) => (<li>{nomeTecnica(t as any)}</li>))}
    </ul>
    <span class="cat-card__link">Ver categoria <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .cat-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    height: 100%;
  }
  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }
  .cat-card__media :global(.foto) { border-radius: 0; }
  .cat-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.15rem 1.25rem;
  }
  .cat-card__title {
    font-size: 1.1rem;
    color: var(--color-apice-blue);
  }
  .cat-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cat-card__tags li {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-apice-red);
    background: color-mix(in srgb, var(--color-apice-red) 8%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  .cat-card__link {
    margin-top: auto;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-apice-blue);
  }
  .cat-card:hover .cat-card__link { color: var(--color-apice-blue-dark); }
</style>
