---
import Foto from './Foto.astro';
import { nomeTecnica } from '../lib/content';

/*
  Card de categoria: foto 4:3, título curto, tags de técnica.

  O card TODO leva à categoria (link "Ver categoria" esticado por cima do card
  via ::after) e, por cima dele, um botão azul independente "Ver catálogo
  completo" que leva ao catálogo XBZ. Não dá pra aninhar <a> dentro de <a>,
  então o card é um <div> — o clique geral vai pra categoria, o botão vai pro
  catálogo (z-index acima do link esticado).
*/
interface Props {
  nome: string;
  slug: string;
  imagemCapa: string;
  tecnicas: ('laser' | 'silk' | 'ambas' | 'sublimacao' | 'silk-sublimacao' | 'impressao-digital-resinada' | 'vinil-transparente' | 'silk-fiber-laser')[];
  priority?: boolean;
}
const { nome, slug, imagemCapa, tecnicas, priority = false } = Astro.props;
// "ambas" expande para silk+laser; outros valores (ex.: sublimacao) se somam,
// em vez de serem substituídos — uma categoria pode ter mais de duas técnicas.
const expandido = tecnicas.flatMap((t) => (t === 'ambas' ? ['silk', 'laser'] : [t]));
const tags = [...new Set(expandido)];
---
<div class="cat-card">
  <div class="cat-card__media">
    <Foto src={imagemCapa} alt={`${nome} personalizados pela Ápice Brindes em Goiânia`} ratio="4/3" priority={priority} />
  </div>
  <div class="cat-card__body">
    <h3 class="cat-card__title">{nome}</h3>
    <ul class="cat-card__tags" aria-label="Técnicas de personalização">
      {tags.map((t) => (<li>{nomeTecnica(t as any)}</li>))}
    </ul>
    <div class="cat-card__actions">
      <a href={`/brindes/${slug}/`} class="cat-card__link" aria-label={`Ver ${nome}`}>
        Ver categoria <span aria-hidden="true">→</span>
      </a>
      <a href="/brindes/catalogo/" class="cat-card__catalogo">Ver catálogo completo</a>
    </div>
  </div>
</div>

<style>
  .cat-card {
    position: relative; /* base do link esticado */
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    height: 100%;
    cursor: pointer;
  }
  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }
  .cat-card__media :global(.foto) { border-radius: 0; }
  .cat-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.15rem 1.25rem;
    flex: 1; /* preenche a altura do card -> margin-top:auto ancora o botão na base
                em todos os cards, independe do nº de tags */
  }
  .cat-card__title {
    font-size: 1.1rem;
    color: var(--color-apice-blue);
  }
  .cat-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cat-card__tags li {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-apice-red);
    background: color-mix(in srgb, var(--color-apice-red) 8%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .cat-card__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem 0.75rem;
    padding-top: 0.25rem;
  }
  /* "Ver categoria" — link principal; ::after estica pra deixar o card todo clicável */
  .cat-card__link {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-apice-blue);
  }
  .cat-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cat-card:hover .cat-card__link { color: var(--color-apice-blue-dark); }

  /* Botão azul do catálogo — por cima do link esticado (z-index), clique próprio */
  .cat-card__catalogo {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    line-height: 1;
    color: #fff;
    background: var(--color-apice-blue);
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(21, 65, 168, 0.28);
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cat-card__catalogo:hover {
    background: var(--color-apice-blue-dark);
    transform: translateY(-1px);
    box-shadow: 0 7px 20px rgba(21, 65, 168, 0.36);
  }
  .cat-card__catalogo:focus-visible {
    outline: 2px solid var(--color-apice-blue);
    outline-offset: 2px;
  }
</style>
