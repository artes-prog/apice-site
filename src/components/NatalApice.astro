---
import { Image, getImage } from 'astro:assets';
import site from '../data/site.json';

import pinheiroAlto from '../assets/img/natal/pinheiro-alto.png';
import pinheiroBaixo from '../assets/img/natal/pinheiro-baixo.png';
import bonecoNeve from '../assets/img/natal/boneco-neve.png';
import casa from '../assets/img/natal/casa.png';
import laser from '../assets/img/natal/laser.png';
import esteira from '../assets/img/natal/esteira.png';
import prensa from '../assets/img/natal/prensa.png';
import mesa from '../assets/img/natal/mesa.png';
import fita from '../assets/img/natal/fita.png';
import arvore from '../assets/img/natal/arvore-presentes.png';
import treno from '../assets/img/natal/treno.png';
import rena from '../assets/img/natal/rena.png';
import caixa from '../assets/img/natal/caixa.png';
import presenteVermelho from '../assets/img/natal/presente-vermelho.png';
import caneca from '../assets/img/natal/caneca.png';
import garrafa from '../assets/img/natal/garrafa.png';
import caderneta from '../assets/img/natal/caderneta.png';
import botton from '../assets/img/natal/botton.png';
import caneta from '../assets/img/natal/caneta.png';
import gorroSrc from '../assets/img/natal/gorro.png';
import luzesSrc from '../assets/img/natal/luzes.png';

/*
  FAIXA SAZONAL DE NATAL — só o cabeçalho.

  Conceito: a oficina do Papai Noel, só que ela fabrica BRINDE CORPORATIVO.
  Da esquerda para a direita: pinheiros, a oficina, a máquina de gravação a
  laser marcando uma caneca, a esteira com os brindes desfilando, a prensa de
  silk, a mesa de embrulho, a árvore montada de caixas de presente, o trenó
  carregado e a rena.

  Por que a oficina fica no CENTRO e em destaque: pinheiro, boneco de neve,
  trenó e rena são o repertório genérico de Natal — é exatamente a vila nevada
  do fornecedor. Enfileirar isso devolveria a sensação de cópia. Os genéricos
  entram só nas pontas, enquadrando; quem conta a história é a oficina.

  Interação: a árvore de presentes é um <button>. Clicar apaga e acende as
  luzes, e a escolha fica salva no navegador.

  Liga/desliga: painel > Empresa > "Decoração de Natal (sazonal)".
  - 'ativo' é avaliado no BUILD: false não renderiza nada (nem markup, nem CSS,
    nem JS). A condição também existe no Header, porque o Astro embarca
    <style>/<script> pelo grafo de import, não pelo que a expressão renderiza.
  - A janela de datas é avaliada no CLIENTE. O site é estático: avaliada no
    build, a faixa não sairia sozinha em janeiro.
*/
const natal = site.natal;
const ativo = natal?.ativo === true;

/* O gorro entra como background de ::after no logo — o logo está fora deste
   componente, então a URL viaja por variável CSS. */
const gorro = ativo ? await getImage({ src: gorroSrc, height: 72, format: 'webp' }) : null;
const luzes = ativo ? await getImage({ src: luzesSrc, height: 36, format: 'webp' }) : null;

/* A esteira roda com esta lista duplicada, para o loop fechar sem salto. */
const naEsteira = [
  { src: caneca, h: 23 },
  { src: garrafa, h: 27 },
  { src: presenteVermelho, h: 22 },
  { src: caderneta, h: 22 },
  { src: botton, h: 18 },
  { src: caneta, h: 11 },
];

/* Neve: posição, atraso e duração variados na mão — aleatório no build geraria
   HTML diferente a cada deploy e sujaria o diff. */
const flocos = [
  [4, 0.0, 9.5, 3], [11, 2.8, 11.0, 2], [18, 5.6, 8.5, 3], [25, 1.4, 12.0, 2],
  [32, 7.2, 10.0, 3], [39, 3.1, 9.0, 2], [46, 8.4, 11.5, 3], [53, 0.7, 10.5, 2],
  [60, 5.0, 8.8, 3], [67, 9.1, 12.5, 2], [74, 2.2, 9.8, 3], [81, 6.3, 11.2, 2],
  [88, 4.0, 10.2, 3], [95, 7.8, 9.3, 2],
];
---

{/*
  As URLs das imagens saem do astro:assets com hash, então viajam por variável
  CSS. Elas moram no .site-header, e não na faixa: o gorro é um ::after do
  .header-logo, que está FORA da faixa — variável declarada na faixa não
  chegaria lá, porque custom property só desce na árvore.
  `is:inline` é obrigatório: o Astro não processa <style> dentro de expressão
  condicional, e sem isso a regra não entra no bundle.
*/}
{ativo && (
  <style
    is:inline
    set:html={`.site-header{--natal-gorro:url(${gorro!.src});--natal-luzes:url(${luzes!.src})}`}
  />
)}

{ativo && (
  <div
    id="natal-faixa"
    class="natal-faixa"
    data-inicio={natal.inicio ?? ''}
    data-fim={natal.fim ?? ''}
  >
    <svg class="natal-fundo" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true">
      <rect x="0" y="0" width="1440" height="64" fill="#F7FBFE" />
      <path d="M0 44 L150 18 L280 44 Z" fill="#E6EFF8" />
      <path d="M220 44 L380 14 L530 44 Z" fill="#DEEAF6" />
      <path d="M640 44 L790 20 L930 44 Z" fill="#E6EFF8" />
      <path d="M980 44 L1140 16 L1290 44 Z" fill="#DEEAF6" />
      <path d="M0 48 Q240 40 480 48 Q720 56 960 48 Q1200 40 1440 48 L1440 64 L0 64 Z" fill="#FFFFFF" />
    </svg>

    <div class="natal-luzes" aria-hidden="true"></div>

    <div class="natal-cena" aria-hidden="true">
      <Image class="p" src={pinheiroAlto} alt="" height={100} format="webp" style="left:8px;height:50px" />
      <Image class="p" src={pinheiroBaixo} alt="" height={80} format="webp" style="left:58px;height:38px" />
      <Image class="p" src={bonecoNeve} alt="" height={88} format="webp" style="left:104px;height:42px" />
      <Image class="p" src={casa} alt="" height={112} format="webp" style="left:156px;height:54px" />

      <div class="natal-laser">
        <Image class="p" src={laser} alt="" height={80} format="webp" style="left:0;height:38px" />
        <span class="natal-feixe"></span>
        <Image class="p" src={caneca} alt="" height={56} format="webp" style="left:46px;height:22px" />
      </div>

      <Image class="p" src={esteira} alt="" height={90} format="webp" style="left:392px;width:300px;height:20px" />
      <div class="natal-trilho">
        <div class="natal-corre">
          {[0, 1].map(() => naEsteira.map((o) => (
            <Image class="natal-item" src={o.src} alt="" height={70} format="webp" style={`height:${o.h}px`} />
          )))}
        </div>
      </div>

      <Image class="p" src={prensa} alt="" height={80} format="webp" style="left:706px;height:38px" />
      <Image class="p" src={mesa} alt="" height={64} format="webp" style="left:788px;height:28px" />
      <Image class="p" src={fita} alt="" height={44} format="webp" style="left:800px;bottom:28px;height:18px" />

      <button
        id="natal-arvore"
        class="natal-arvore"
        type="button"
        aria-pressed="true"
        aria-label="Apagar as luzes de Natal"
      >
        <Image src={arvore} alt="" height={116} format="webp" style="height:56px" />
        <span class="natal-brilho natal-b1"></span>
        <span class="natal-brilho natal-b2"></span>
        <span class="natal-brilho natal-b3"></span>
      </button>

      <Image class="p" src={treno} alt="" height={76} format="webp" style="left:996px;height:34px" />
      <Image class="p" src={rena} alt="" height={86} format="webp" style="left:1086px;height:41px" />
      <Image class="p" src={caixa} alt="" height={64} format="webp" style="left:1148px;height:26px" />
      <Image class="p" src={pinheiroBaixo} alt="" height={80} format="webp" style="left:1206px;height:36px" />
      <Image class="p" src={pinheiroAlto} alt="" height={100} format="webp" style="left:1256px;height:48px" />
      <Image class="p" src={presenteVermelho} alt="" height={56} format="webp" style="left:1320px;height:24px" />
      <Image class="p" src={pinheiroBaixo} alt="" height={80} format="webp" style="left:1368px;height:34px" />
    </div>

    <div class="natal-neve" aria-hidden="true">
      {flocos.map(([x, atraso, dur, tam]) => (
        <span style={`left:${x}%;animation-delay:-${atraso}s;animation-duration:${dur}s;width:${tam}px;height:${tam}px`}></span>
      ))}
    </div>
  </div>
)}

<style is:global>
    /*
      Este bloco fica no NÍVEL RAIZ do componente de propósito. O Astro extrai
      <style> estaticamente: dentro de uma expressão condicional o estilo não
      é processado e simplesmente não entra no bundle.

      Tudo aqui está preso a #natal-faixa / .natal-*, que só existem quando o
      Header renderiza o componente. Com a decoração desligada o CSS viaja
      inerte — não cria nada e fica em cache único para o site inteiro.
    */

    /* A faixa só aparece dentro da janela de datas, liberada pelo JS.
       Fora dela não ocupa espaço: o header volta exatamente ao que era. */
    #natal-faixa { display: none; }
    #natal-faixa[data-janela] { display: block; }

    .natal-faixa {
      position: relative;
      height: 64px;
      overflow: hidden;
      border-bottom: 2px solid var(--color-apice-blue);
      contain: paint;
    }
    .natal-fundo { position: absolute; inset: 0; width: 100%; height: 100%; }

    .natal-luzes {
      position: absolute; top: 0; left: 0; right: 0; height: 18px;
      background-image: var(--natal-luzes);
      background-repeat: repeat-x;
      background-size: auto 18px;
      transition: opacity .45s ease;
    }

    .natal-cena {
      position: absolute; inset: 0;
      width: 1440px; margin-inline: auto;
      left: 50%; transform: translateX(-50%);
      /* Decoração não intercepta clique. Sem isto a camada de neve, que cobre
         a faixa inteira e vem por cima, engole o clique na árvore. */
      pointer-events: none;
    }
    .natal-fundo, .natal-luzes, .natal-neve { pointer-events: none; }
    .natal-cena .p,
    .natal-arvore { position: absolute; bottom: 4px; width: auto; }

    .natal-laser { position: absolute; left: 306px; bottom: 4px; width: 90px; height: 44px; }
    .natal-laser .p { bottom: 0; }
    .natal-feixe {
      position: absolute; left: 53px; bottom: 20px;
      width: 2px; height: 14px;
      background: #C9A227;
      box-shadow: 0 0 5px 2px rgba(201,162,39,.75);
      animation: natal-pulso 1.5s ease-in-out infinite;
    }

    .natal-trilho {
      position: absolute; left: 392px; bottom: 23px;
      width: 300px; height: 30px; overflow: hidden;
    }
    .natal-corre {
      display: flex; align-items: flex-end; gap: 28px;
      height: 100%; width: max-content;
      animation: natal-esteira 16s linear infinite;
    }
    .natal-item { width: auto; flex: none; }

    .natal-arvore {
      left: 882px; bottom: 3px;
      padding: 0; border: 0; background: none; cursor: pointer;
      line-height: 0;
      pointer-events: auto;  /* reabilita só o que é clicável */
    }
    .natal-arvore img { width: auto; display: block; }
    .natal-arvore:focus-visible { outline: 2px solid var(--color-apice-blue); outline-offset: 2px; }

    .natal-brilho {
      position: absolute; width: 5px; height: 5px; border-radius: 50%;
      background: #FFE680;
      box-shadow: 0 0 6px 2px rgba(255,214,61,.9);
      animation: natal-pisca 1.8s steps(1, end) infinite;
    }
    .natal-b1 { left: 22px; top: 14px; }
    .natal-b2 { left: 8px;  top: 32px; animation-delay: .6s; }
    .natal-b3 { left: 34px; top: 40px; animation-delay: 1.2s; }

    .natal-neve { position: absolute; inset: 0; }
    .natal-neve span {
      position: absolute; top: -6px;
      border-radius: 50%; background: #FFFFFF; opacity: .92;
      animation-name: natal-cai;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    /* Gorro no logo. O logo vive fora deste componente, então a imagem chega
       por variável CSS e entra como ::after — sem tocar no Header.astro. */
    .site-header:has(#natal-faixa[data-janela]) .header-logo { position: relative; }
    .site-header:has(#natal-faixa[data-janela]) .header-logo::after {
      content: ''; position: absolute;
      top: -9px; right: -13px;
      width: 34px; height: 34px;
      background-image: var(--natal-gorro);
      background-size: contain; background-repeat: no-repeat;
      transform: rotate(14deg);
      pointer-events: none;
    }

    /* Luzes apagadas pelo clique na árvore */
    #natal-faixa[data-luzes='0'] .natal-luzes { opacity: .28; }
    #natal-faixa[data-luzes='0'] .natal-brilho { animation: none; opacity: 0; }

    @keyframes natal-cai {
      0%   { transform: translateY(-6px) translateX(0); }
      100% { transform: translateY(72px) translateX(10px); }
    }
    @keyframes natal-esteira {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @keyframes natal-pisca {
      0%, 49%   { opacity: 1; }
      50%, 100% { opacity: .15; }
    }
    @keyframes natal-pulso {
      0%, 100% { opacity: .5; }
      50%      { opacity: 1; }
    }

    @media (max-width: 900px) {
      .natal-faixa { height: 44px; }
      .natal-cena { width: 820px; transform: translateX(-50%) scale(.68); transform-origin: bottom center; }
      .site-header:has(#natal-faixa[data-janela]) .header-logo::after {
        width: 26px; height: 26px; top: -7px; right: -10px;
      }
    }

    /* A regra global de global.css zera a DURAÇÃO das animações, não impede
       que elas rodem. Aqui elas são desligadas de vez: a cena fica parada,
       com tudo visível. */
    @media (prefers-reduced-motion: reduce) {
      .natal-neve { display: none; }
      .natal-corre, .natal-brilho, .natal-feixe { animation: none; }
      .natal-brilho { opacity: 1; }
    }
</style>

<script is:inline>
    (function () {
      var CHAVE = 'apice:natal:luzes';

      function hojeISO() {
        var d = new Date();
        return d.getFullYear() + '-' +
          String(d.getMonth() + 1).padStart(2, '0') + '-' +
          String(d.getDate()).padStart(2, '0');
      }

      function naJanela(el) {
        var h = hojeISO();
        var i = el.dataset.inicio || '';
        var f = el.dataset.fim || '';
        if (i && h < i) return false;
        if (f && h > f) return false;
        return true;
      }

      function initNatal() {
        var faixa = document.getElementById('natal-faixa');
        if (!faixa || faixa.dataset.wired) return;
        faixa.dataset.wired = '1';

        // Fora da janela de datas a faixa nem aparece — e como ela é display:none,
        // o header volta à altura original, sem sobra nem deslocamento.
        if (!naJanela(faixa)) return;
        faixa.dataset.janela = '1';

        var arvore = document.getElementById('natal-arvore');
        if (!arvore) return;

        var acesas = true;
        try { acesas = localStorage.getItem(CHAVE) !== '0'; } catch (e) {}
        aplicar(acesas);

        function aplicar(on) {
          faixa.dataset.luzes = on ? '1' : '0';
          arvore.setAttribute('aria-pressed', String(on));
          arvore.setAttribute('aria-label', on ? 'Apagar as luzes de Natal' : 'Acender as luzes de Natal');
        }

        arvore.addEventListener('click', function () {
          acesas = !acesas;
          aplicar(acesas);
          try { localStorage.setItem(CHAVE, acesas ? '1' : '0'); } catch (e) {}
        });
      }

      // <ClientRouter /> não re-executa módulos: monta no page-load, sempre.
      document.addEventListener('astro:page-load', initNatal);
    })();
</script>
