---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import galho from '../assets/img/natal/galho.webp';

/*
  DECORAÇÃO NATALINA DA HOME — camada A.

  Três peças, cada uma num espaço que já estava vazio:
    galhos  -> cantos superiores da seção do hero
    neve    -> toda a altura do hero, bem rarefeita
    selo    -> abaixo dos CTAs, em fluxo normal

  Nada aqui empurra conteúdo nem cobre texto: os galhos e a neve são camadas
  absolutas com pointer-events:none, e o selo entra no fluxo, depois do CTA.

  Visibilidade: tudo depende de html[data-natal], marcado pelo script do
  NatalApice quando a data cai dentro da janela. Fora dela nada aparece, e o
  layout volta exatamente ao que era.

  Cada peça tem sua própria chave no painel (galhos / neve / selo).
*/
interface Props {
  variante: 'cantos' | 'selo';
}
const { variante } = Astro.props;

const natal = site.natal;
const ativo = natal?.ativo === true;
const usarGalhos = ativo && natal.galhos !== false;
const usarNeve = ativo && natal.neve !== false;
const usarSelo = ativo && natal.selo !== false;

/* Neve: valores fixos, não aleatórios. Sorteio no build geraria HTML diferente
   a cada deploy e sujaria o diff sem motivo. */
const flocos = [
  [6, 0.0, 15], [14, 5.2, 19], [23, 2.4, 16], [31, 8.1, 21],
  [43, 3.6, 17], [52, 10.4, 20], [61, 1.3, 18], [69, 6.8, 22],
  [78, 4.1, 16], [87, 9.3, 19], [94, 2.0, 21],
];
---

{variante === 'cantos' && (usarGalhos || usarNeve) && (
  <div class="natal-home" aria-hidden="true">
    {usarGalhos && (
      <>
        <Image class="natal-galho natal-galho--esq" src={galho} alt="" width={460} format="webp" loading="eager" />
        <Image class="natal-galho natal-galho--dir" src={galho} alt="" width={460} format="webp" loading="eager" />
      </>
    )}
    {usarGalhos && (
      <div class="natal-festao">
        <svg class="natal-festao__fio" viewBox="0 0 400 26" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 3 Q100 24 200 12 Q300 0 400 16" fill="none" stroke="#0B3D2E" stroke-width="2" />
        </svg>
        {[
          [8, 13, '#F30D0E'], [23, 21, '#C9A227'], [38, 15, '#0B3D2E'],
          [54, 25, '#F30D0E'], [70, 17, '#C9A227'], [86, 12, '#F30D0E'],
        ].map(([x, fio, cor], i) => (
          <span class="natal-bolinha" style={`left:${x}%;--fio:${fio}px;--cor:${cor};animation-delay:-${i * 0.5}s`}></span>
        ))}
      </div>
    )}
    {usarNeve && (
      <div class="natal-neve-home">
        {flocos.map(([x, atraso, dur]) => (
          <span style={`left:${x}%;animation-delay:-${atraso}s;animation-duration:${dur}s`}></span>
        ))}
      </div>
    )}
  </div>
)}

{variante === 'selo' && usarSelo && (
  <p class="natal-selo">
    <span class="natal-selo__tag">Natal Ápice 2026</span>
    <span class="natal-selo__texto">Personalize presentes que fazem sua marca ser lembrada.</span>
  </p>
)}

<style is:global>
  /*
    No nível raiz do componente de propósito: o Astro extrai <style>
    estaticamente, e dentro de expressão condicional o CSS não entra no bundle.
    Tudo está preso a .natal-* ou a html[data-natal], então com a decoração
    desligada o CSS viaja inerte.
  */

  /* A seção do hero vira o contexto de posicionamento das camadas. */
  html[data-natal] .hero { position: relative; }
  .natal-home { display: none; }
  html[data-natal] .natal-home {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;  /* decoração nunca rouba clique */
  }

  .natal-galho {
    position: absolute;
    top: 0;
    width: 230px;
    height: auto;
    opacity: 0.9;
  }
  /* Os galhos ficam PARA FORA, só a ponta entrando na tela — por isso os
     deslocamentos negativos. Assim emolduram sem disputar com o H1. */
  .natal-galho--esq { left: -46px; transform: rotate(-4deg); }
  .natal-galho--dir { right: -46px; transform: scaleX(-1) rotate(-4deg); }

  /*
    FESTÃO — decoração exclusiva do celular.

    No desktop os galhos ocupam os cantos superiores, que ali são espaço morto.
    No celular o hero empilha e aquele canto vira o começo do texto, então em
    vez de simplesmente remover a decoração, ela muda de forma: o hero tem
    40px de padding no topo, uma faixa de largura inteira sem nada. O festão
    mora exatamente nela e não encosta em texto nenhum.

    Desenhado em CSS e SVG, sem imagem: pesa zero e acompanha qualquer largura.
  */
  .natal-festao { display: none; }
  .natal-festao__fio { position: absolute; inset: 0 0 auto; width: 100%; height: 26px; }
  .natal-bolinha {
    position: absolute;
    top: 0;
    width: 11px;
    height: 11px;
    transform-origin: 50% calc(-1 * var(--fio));
    animation: natal-balanco 3.6s ease-in-out infinite;
  }
  /* O fio e a bola giram juntos, presos ao ponto de suspensão. */
  .natal-bolinha::before {
    content: '';
    position: absolute;
    left: 50%; bottom: 100%;
    width: 1px; height: var(--fio);
    background: #0B3D2E;
  }
  .natal-bolinha::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--cor);
    box-shadow: inset -2px -2px 3px rgba(0, 0, 0, 0.22);
  }
  @keyframes natal-balanco {
    0%, 100% { transform: rotate(-5deg); }
    50%      { transform: rotate(5deg); }
  }

  .natal-neve-home { position: absolute; inset: 0; }
  .natal-neve-home span {
    position: absolute;
    top: -12px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #BBD4EA;
    opacity: 0.5;
    animation-name: natal-neve-home;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes natal-neve-home {
    0%   { transform: translate3d(0, -12px, 0); }
    100% { transform: translate3d(22px, 105%, 0); }
  }

  .natal-selo { display: none; }
  html[data-natal] .natal-selo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
    padding: 0.55rem 0.9rem 0.55rem 0.55rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-natal-ouro);
    border-radius: var(--radius-card);
    background: var(--color-paper-soft);
  }
  .natal-selo__tag {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--color-apice-white);
    background: var(--color-natal-verde);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .natal-selo__texto {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    /*
      Galhos somem no celular. No desktop o hero é em duas colunas e os cantos
      superiores são espaço morto; no celular ele empilha e aquele canto passa
      a ser onde começa o texto — o galho cobria a linha "Silk Screen e
      gravação com Fiber Laser". Legibilidade ganha de enfeite.
      O clima de Natal no celular já vem da faixa, do logo e do selo.
    */
    .natal-galho { display: none; }
    .natal-festao { display: block; }   /* a decoracao troca de forma, nao some */
    .natal-neve-home span:nth-child(even) { display: none; }
  }

  /*
    A regra global do global.css zera a DURAÇÃO das animações, não impede que
    rodem. Aqui a neve some de vez: movimento perpétuo é justamente o que
    incomoda quem pediu menos movimento.
  */
  @media (prefers-reduced-motion: reduce) {
    .natal-neve-home { display: none; }
  }
</style>
