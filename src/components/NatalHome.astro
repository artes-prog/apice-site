---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import galho from '../assets/img/natal/galho.webp';

/*
  DECORAÇÃO NATALINA DA HOME — camada A.

  Três peças, cada uma num espaço que já estava vazio:
    galhos  -> cantos superiores da seção do hero
    neve    -> toda a altura do hero, bem rarefeita
    selo    -> abaixo dos CTAs, em fluxo normal

  Nada aqui empurra conteúdo nem cobre texto: os galhos e a neve são camadas
  absolutas com pointer-events:none, e o selo entra no fluxo, depois do CTA.

  Visibilidade: tudo depende de html[data-natal], marcado pelo script do
  NatalApice quando a data cai dentro da janela. Fora dela nada aparece, e o
  layout volta exatamente ao que era.

  Cada peça tem sua própria chave no painel (galhos / neve / selo).
*/
interface Props {
  variante: 'topo' | 'cantos' | 'selo' | 'rodape' | 'recado';
}
const { variante } = Astro.props;

const natal = site.natal;
const ativo = natal?.ativo === true;
const usarGalhos = ativo && natal.galhos !== false;
const usarNeve = ativo && natal.neve !== false;
const usarSelo = ativo && natal.selo !== false;
const usarRodape = ativo && natal.rodape !== false;

/* Neve: valores fixos, não aleatórios. Sorteio no build geraria HTML diferente
   a cada deploy e sujaria o diff sem motivo. */
const flocos = [
  [6, 0.0, 15], [14, 5.2, 19], [23, 2.4, 16], [31, 8.1, 21],
  [43, 3.6, 17], [52, 10.4, 20], [61, 1.3, 18], [69, 6.8, 22],
  [78, 4.1, 16], [87, 9.3, 19], [94, 2.0, 21],
];
---

{variante === 'cantos' && usarGalhos && (
  <div class="natal-cantos" aria-hidden="true">
    <Image class="natal-galho natal-galho--esq" src={galho} alt="" width={460} format="webp" loading="eager" />
    <Image class="natal-galho natal-galho--dir" src={galho} alt="" width={460} format="webp" loading="eager" />
  </div>
)}

{variante === 'topo' && (usarGalhos || usarNeve) && (
  <div class="natal-home" aria-hidden="true">
    {usarGalhos && (
      <div class="natal-festao">
        <svg class="natal-festao__fio" viewBox="0 0 400 26" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 3 Q100 24 200 12 Q300 0 400 16" fill="none" stroke="#0B3D2E" stroke-width="2" />
        </svg>
        {[
          [8, 13, '#F30D0E'], [23, 21, '#C9A227'], [38, 15, '#0B3D2E'],
          [54, 25, '#F30D0E'], [70, 17, '#C9A227'], [86, 12, '#F30D0E'],
        ].map(([x, fio, cor], i) => (
          <span class="natal-bolinha" style={`left:${x}%;--fio:${fio}px;--cor:${cor};animation-delay:-${i * 0.5}s`}></span>
        ))}
      </div>
    )}
    {usarNeve && (
      <div class="natal-neve-home">
        {flocos.map(([x, atraso, dur]) => (
          <span style={`left:${x}%;animation-delay:-${atraso}s;animation-duration:${dur}s`}></span>
        ))}
      </div>
    )}
  </div>
)}

{variante === 'rodape' && usarRodape && (
  <div class="natal-rodape" aria-hidden="true">
    <svg class="natal-rodape__fio" viewBox="0 0 400 22" preserveAspectRatio="none">
      <path d="M0 14 Q100 2 200 11 Q300 20 400 6" fill="none" stroke="#C9A227" stroke-width="1.6" opacity="0.75" />
    </svg>
    {[
      [11, 11, '#C9A227'], [27, 17, '#F30D0E'], [44, 12, '#FFFFFF'],
      [61, 19, '#C9A227'], [77, 13, '#F30D0E'], [91, 16, '#C9A227'],
    ].map(([x, fio, cor], i) => (
      <span class="natal-rodape__bola" style={`left:${x}%;--fio:${fio}px;--cor:${cor};animation-delay:-${i * 0.6}s`}></span>
    ))}
    {[[18, 36], [49, 22], [72, 44], [95, 30]].map(([x, y], i) => (
      <span class="natal-estrela" style={`left:${x}%;top:${y}px;animation-delay:-${i * 0.9}s`}></span>
    ))}
  </div>
)}

{variante === 'recado' && usarRodape && (
  <p class="natal-recado">Neste Natal, faça sua marca estar presente nos melhores momentos.</p>
)}

{variante === 'selo' && usarSelo && (
  <p class="natal-selo">
    <span class="natal-selo__tag">Natal Ápice 2026</span>
    <span class="natal-selo__texto">Personalize presentes que fazem sua marca ser lembrada.</span>
  </p>
)}

<style is:global>
  /*
    No nível raiz do componente de propósito: o Astro extrai <style>
    estaticamente, e dentro de expressão condicional o CSS não entra no bundle.
    Tudo está preso a .natal-* ou a html[data-natal], então com a decoração
    desligada o CSS viaja inerte.
  */

  /* O <main> vira o contexto de posicionamento: a camada vive em TODA pagina,
     nao so na home. Toda pagina do site abre com uma secao de titulo, entao os
     cantos superiores do <main> sao o mesmo lugar em todas elas. */
  html[data-natal] main#conteudo { position: relative; }

  /*
    Banda garantida no topo de toda pagina. Sem ela o festao colidia com o
    titulo nas paginas internas, que tem bem menos respiro no topo que o hero
    da home. 46px e o suficiente para o fio e as bolinhas.
  */
  html[data-natal] main#conteudo { padding-top: 46px; }

  /* Galhos: so na home, ancorados no hero. Nas paginas internas o titulo
     comeca perto do topo e eles cobriam o H1 — medido no Portfolio. */
  html[data-natal] .hero { position: relative; }
  .natal-cantos { display: none; }
  html[data-natal] .natal-cantos {
    display: block;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .natal-home { display: none; }
  html[data-natal] .natal-home {
    display: block;
    position: absolute;
    top: 0; left: 0; right: 0;
    /* Altura fixa, nao `inset: 0`: o <main> de uma pagina de catalogo tem
       milhares de pixels, e neve caindo por toda essa altura seria tempestade,
       nao delicadeza. A decoracao vive so na primeira dobra. */
    height: 420px;
    overflow: hidden;
    pointer-events: none;  /* decoração nunca rouba clique */
  }

  .natal-galho {
    position: absolute;
    top: 0;
    width: 230px;
    height: auto;
    opacity: 0.9;
  }
  /* Os galhos ficam PARA FORA, só a ponta entrando na tela — por isso os
     deslocamentos negativos. Assim emolduram sem disputar com o H1. */
  .natal-galho--esq { left: -46px; transform: rotate(-4deg); }
  .natal-galho--dir { right: -46px; transform: scaleX(-1) rotate(-4deg); }

  /*
    FESTÃO — decoração exclusiva do celular.

    No desktop os galhos ocupam os cantos superiores, que ali são espaço morto.
    No celular o hero empilha e aquele canto vira o começo do texto, então em
    vez de simplesmente remover a decoração, ela muda de forma: o hero tem
    40px de padding no topo, uma faixa de largura inteira sem nada. O festão
    mora exatamente nela e não encosta em texto nenhum.

    Desenhado em CSS e SVG, sem imagem: pesa zero e acompanha qualquer largura.
  */
  /* O festao vale para toda largura e toda pagina: e a decoracao que cabe na
     banda garantida do topo sem disputar espaco com titulo nenhum. */
  html[data-natal] .natal-festao { display: block; }
  .natal-festao { display: none; }
  .natal-festao__fio { position: absolute; inset: 0 0 auto; width: 100%; height: 26px; }
  .natal-bolinha {
    position: absolute;
    top: 0;
    width: 11px;
    height: 11px;
    transform-origin: 50% calc(-1 * var(--fio));
    animation: natal-balanco 3.6s ease-in-out infinite;
  }
  /* O fio e a bola giram juntos, presos ao ponto de suspensão. */
  .natal-bolinha::before {
    content: '';
    position: absolute;
    left: 50%; bottom: 100%;
    width: 1px; height: var(--fio);
    background: #0B3D2E;
  }
  .natal-bolinha::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--cor);
    box-shadow: inset -2px -2px 3px rgba(0, 0, 0, 0.22);
  }
  @keyframes natal-balanco {
    0%, 100% { transform: rotate(-5deg); }
    50%      { transform: rotate(5deg); }
  }

  .natal-neve-home { position: absolute; inset: 0; }
  .natal-neve-home span {
    position: absolute;
    top: -12px;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #BBD4EA;
    opacity: 0.5;
    animation-name: natal-neve-home;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes natal-neve-home {
    0%   { transform: translate3d(0, -12px, 0); opacity: 0; }
    12%  { opacity: 0.5; }
    78%  { opacity: 0.5; }
    /* Some antes de chegar na borda da camada: cortado em seco pelo
       overflow ficaria evidente que ha um limite invisivel. */
    100% { transform: translate3d(22px, 420px, 0); opacity: 0; }
  }

  /*
    RODAPÉ — fundo azul da marca, então a paleta muda: dourado, branco e
    vermelho. O verde garrafa do festão do topo sumiria contra o azul escuro.

    Mesmo gesto do topo (fio com bolinhas penduradas), para o site abrir e
    fechar com a mesma linguagem, mais estrelas douradas piscando devagar.
  */
  .natal-rodape { display: none; }
  html[data-natal] .site-footer { position: relative; }
  html[data-natal] .natal-rodape {
    display: block;
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 72px;
    overflow: hidden;
    pointer-events: none;
  }
  .natal-rodape__fio { position: absolute; inset: 0 0 auto; width: 100%; height: 22px; }
  .natal-rodape__bola {
    position: absolute;
    top: 0;
    width: 10px; height: 10px;
    transform-origin: 50% calc(-1 * var(--fio));
    animation: natal-balanco 4.2s ease-in-out infinite;
  }
  .natal-rodape__bola::before {
    content: '';
    position: absolute;
    left: 50%; bottom: 100%;
    width: 1px; height: var(--fio);
    background: #C9A227;
    opacity: 0.7;
  }
  .natal-rodape__bola::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--cor);
    box-shadow: inset -2px -2px 3px rgba(0, 0, 0, 0.3);
  }

  /* Estrela de 4 pontas em clip-path: sem imagem, nítida em qualquer tela. */
  .natal-estrela {
    position: absolute;
    width: 12px; height: 12px;
    background: #C9A227;
    clip-path: polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%);
    animation: natal-brilha 3.4s ease-in-out infinite;
  }
  @keyframes natal-brilha {
    0%, 100% { opacity: 0.25; transform: scale(0.8); }
    50%      { opacity: 0.9;  transform: scale(1); }
  }

  .natal-recado { display: none; }
  html[data-natal] .natal-recado {
    display: block;
    margin: 1.1rem 0 0;
    padding-left: 0.85rem;
    border-left: 2px solid var(--color-natal-ouro);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.5;
    color: #FFFFFF;
    opacity: 0.92;
  }

  /*
    MICROINTERACOES (§7) — mao leve de proposito.

    So DOIS elementos ganham efeito: o botao principal do cabecalho e os
    cartoes de categoria. O briefing pede explicitamente para nao animar tudo
    ao mesmo tempo, e o site ja tem hover proprio nesses dois — aqui apenas
    um brilho dourado se soma, sem substituir nada.

    O WhatsApp fica de fora, intocado: verde e o sinal de conversao do site
    (Guia de Estilo §1.2) e nao se mexe nele.

    Nada de deslocamento novo: os transforms que ja existiam continuam, e o
    acrescimo e so box-shadow e borda, que nao causam reflow.
  */
  html[data-natal] .header-cta {
    transition: background .2s ease, transform .2s ease, box-shadow .25s ease;
  }
  html[data-natal] .header-cta:hover {
    box-shadow: 0 0 0 2px rgba(201, 162, 39, 0.55), 0 4px 14px rgba(201, 162, 39, 0.3);
  }

  html[data-natal] .cat-card {
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  html[data-natal] .cat-card:hover {
    border-color: var(--color-natal-ouro);
    box-shadow: 0 6px 22px rgba(201, 162, 39, 0.22);
  }

  /* Sem efeito novo para quem pediu menos movimento. */
  @media (prefers-reduced-motion: reduce) {
    html[data-natal] .header-cta,
    html[data-natal] .cat-card { transition: none; }
  }

  .natal-selo { display: none; }
  html[data-natal] .natal-selo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
    padding: 0.55rem 0.9rem 0.55rem 0.55rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-natal-ouro);
    border-radius: var(--radius-card);
    background: var(--color-paper-soft);
  }
  .natal-selo__tag {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--color-apice-white);
    background: var(--color-natal-verde);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .natal-selo__texto {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    /*
      Galhos somem no celular. No desktop o hero é em duas colunas e os cantos
      superiores são espaço morto; no celular ele empilha e aquele canto passa
      a ser onde começa o texto — o galho cobria a linha "Silk Screen e
      gravação com Fiber Laser". Legibilidade ganha de enfeite.
      O clima de Natal no celular já vem da faixa, do logo e do selo.
    */
    /* No celular o hero empilha e os cantos superiores viram o comeco do
       texto — o galho cobria a linha "Silk Screen e gravacao com Fiber Laser".
       O festao do topo continua, entao a home nao fica sem decoracao. */
    .natal-galho { display: none; }
    .natal-neve-home span:nth-child(even) { display: none; }
  }

  /*
    A regra global do global.css zera a DURAÇÃO das animações, não impede que
    rodem. Aqui a neve some de vez: movimento perpétuo é justamente o que
    incomoda quem pediu menos movimento.
  */
  @media (prefers-reduced-motion: reduce) {
    .natal-neve-home { display: none; }
  }
</style>
