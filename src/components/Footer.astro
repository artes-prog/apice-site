---
import Logo from './Logo.astro';
import { site, enderecoLinha, redesFooter } from '../data/site';
import { linkWhatsApp, mensagens } from '../lib/whatsapp';

/*
  Rodapé institucional (azul = estrutura/confiança, Guia §1.2).
  NAP (nome/endereço/telefone) vem de src/data/site.ts — a MESMA fonte do
  /contato/ e do JSON-LD, garantindo NAP idêntico caractere a caractere (§5.4).
*/
interface Props {
  categorias: { nome: string; slug: string }[];
}
const { categorias } = Astro.props;
const redes = redesFooter();
const ano = new Date().getFullYear();

/*
  Assinatura do desenvolvedor (Guilherme) — crédito discreto no rodapé, com o
  telefone dele clicável direto pro WhatsApp DELE (divulgação do trabalho).
  Sem data-wa de propósito: não deve contar como lead da Ápice nas métricas.
*/
const linkGuilherme = linkWhatsApp(
  '5562999187515',
  'Olá, Guilherme! Vi o site que você fez para a Ápice Brindes e gostaria de falar sobre um projeto.'
);

const paginas = [
  { href: '/brindes-personalizados/', label: 'Todos os brindes' },
  { href: '/gravacao-a-laser/', label: 'Gravação a laser' },
  { href: '/silk-screen/', label: 'Silk screen' },
  { href: '/blog/', label: 'Blog' },
  { href: '/sobre/', label: 'Sobre a Ápice' },
  { href: '/orcamento/', label: 'Pedir orçamento' },
  { href: '/contato/', label: 'Contato' },
];
---
<footer class="site-footer">
  <div class="container-site footer-grid">
    <div class="footer-brand">
      <Logo variant="branco" class="footer-logo" />
      <p class="footer-slogan">{site.slogan}</p>
      <p class="footer-selo">{site.anosDeMercado} de mercado · Produção própria de silk e Fiber Laser em Goiânia.</p>
      {redes.length > 0 && (
        <ul class="footer-social" aria-label="Redes sociais">
          {redes.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={r.nome}>
                {r.nome === 'Instagram' ? (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.2A6.6 6.6 0 1 0 12 18.6 6.6 6.6 0 0 0 12 5.4zm0 10.9A4.3 4.3 0 1 1 12 7.7a4.3 4.3 0 0 1 0 8.6zm6.8-11.2a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>
                ) : (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav class="footer-col" aria-label="Páginas">
      <h2 class="footer-title">Navegar</h2>
      <ul>
        {paginas.map((p) => (<li><a href={p.href}>{p.label}</a></li>))}
      </ul>
    </nav>

    <nav class="footer-col footer-col--brindes" aria-label="Categorias de brindes">
      <h2 class="footer-title">Brindes</h2>
      <ul class="footer-brindes">
        {categorias.map((c) => (
          <li><a href={`/brindes/${c.slug}/`}>{c.nome}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-contato">
      <h2 class="footer-title">Contato</h2>
      <address>
        <p class="nap-nome">{site.nome}</p>
        <p>{enderecoLinha()}</p>
        <p>Telefone: {site.telefoneFixo}</p>
        <p>{site.horario}</p>
      </address>
      <ul class="footer-wa">
        {site.atendentes.map((a) => (
          <li>
            <a
              href={linkWhatsApp(a.whatsapp, mensagens.generico)}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-wa-btn"
              data-wa
              data-pagina="footer"
              data-atendente={a.nome}
            >
              <svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16 3C9.4 3 4 8.3 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.6 1.4 5.6 1.4h.2c6.6 0 12-5.3 12-12S22.6 3 16 3zm0 21.8c-1.7 0-3.4-.5-4.9-1.3l-.4-.2-4.9 1 1-4.7-.3-.5C5.6 18.4 5 16.7 5 15 5 9.9 9.9 5.9 16 5.9S27 9.9 27 15s-4.9 9.8-11 9.8z"/></svg>
              Falar com {a.nome}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer-bar">
    <div class="container-site footer-bar-inner">
      <p>© {ano} {site.nome}</p>

      <a
        class="dev-sig"
        href={linkGuilherme}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Site desenvolvido por Guilherme — falar no WhatsApp (62) 9 9918-7515"
      >
        <span class="dev-sig__code" aria-hidden="true">&lt;/&gt;</span>
        <span class="dev-sig__txt">Site criado por <strong>Guilherme</strong></span>
        <span class="dev-sig__dot" aria-hidden="true"></span>
        <span class="dev-sig__wa">
          <svg viewBox="0 0 32 32" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M16 3C9.4 3 4 8.3 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.6 1.4 5.6 1.4h.2c6.6 0 12-5.3 12-12S22.6 3 16 3zm0 21.8c-1.7 0-3.4-.5-4.9-1.3l-.4-.2-4.9 1 1-4.7-.3-.5C5.6 18.4 5 16.7 5 15 5 9.9 9.9 5.9 16 5.9S27 9.9 27 15s-4.9 9.8-11 9.8z"/></svg>
          (62) 9 9918-7515
        </span>
      </a>

      <a href="/politica-de-privacidade/">Política de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-apice-blue);
    color: #fff;
    margin-top: 4rem;
    /* kerning e formas de letra mais limpas no rodapé inteiro */
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    font-feature-settings: "kern" 1, "liga" 1;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: 3.5rem 3rem;
    align-items: start; /* todas as colunas alinhadas pelo topo */
  }
  .footer-logo { height: 40px; }
  .footer-slogan {
    margin-top: 1rem;
    font-weight: 600;
    line-height: 1.4;
    max-width: 26ch;
    text-wrap: balance;
  }
  .footer-selo {
    margin-top: 0.55rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    max-width: 34ch;
  }
  .footer-social {
    list-style: none;
    display: flex;
    gap: 0.75rem;
    padding: 0;
    margin-top: 1.1rem;
  }
  .footer-social a {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    color: #fff;
    transition: background 0.15s ease;
  }
  .footer-social a:hover { background: rgba(255, 255, 255, 0.14); }

  /* Rótulo de seção: caixa-alta pequena pede MAIS tracking pra ficar legível/elegante,
     e um "tick" vermelho curto dá estrutura visual sem pesar. */
  .footer-title {
    position: relative;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    font-weight: 700;
    font-family: var(--font-display);
    padding-bottom: 0.7rem;
    margin-bottom: 1.05rem;
  }
  .footer-title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-apice-red);
  }
  .footer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.62rem; }
  .footer-col a {
    font-size: 0.92rem;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.82);
    transition: color 0.15s ease;
  }
  .footer-col a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  /* Categorias de brindes em 2 colunas no desktop -> equilibra a altura com as
     outras colunas (senão os 9 itens descem muito além do resto). */
  .footer-brindes { gap: 0.62rem 1.5rem; }

  .footer-contato address { font-style: normal; display: grid; gap: 0.35rem; font-size: 0.95rem; color: rgba(255, 255, 255, 0.92); }
  .nap-nome { font-weight: 700; color: #fff; }
  .footer-wa { list-style: none; padding: 0; margin: 1.1rem 0 0; display: grid; gap: 0.6rem; }
  .footer-wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-wa-green);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    justify-content: center;
  }
  .footer-wa-btn:hover { background: var(--color-wa-green-dark); }

  .footer-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    background: var(--color-apice-blue-dark);
  }
  /* Mobile: empilha e centraliza. Desktop (grid 3 zonas): © à esquerda,
     assinatura perfeitamente no centro, política à direita. */
  .footer-bar-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
    padding-block: 1.15rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .footer-bar-inner a:not(.dev-sig):hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 760px) {
    .footer-bar-inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1rem 1.5rem;
    }
    .footer-bar-inner > :first-child { justify-self: start; text-align: left; }
    .footer-bar-inner > :last-child { justify-self: end; text-align: right; }
  }

  /* Assinatura do desenvolvedor (Guilherme) — crédito discreto e clicável */
  .dev-sig {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.32rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }
  .dev-sig:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .dev-sig__code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 700;
    color: var(--color-apice-red);
    letter-spacing: -0.06em;
  }
  .dev-sig__txt strong { color: #fff; font-weight: 700; }
  .dev-sig__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
    flex: none;
  }
  .dev-sig__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    color: var(--color-wa-green);
    font-weight: 600;
    white-space: nowrap;
  }
  .dev-sig:hover .dev-sig__wa { color: #3ddc7f; }

  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; }
  }
  @media (min-width: 960px) {
    .footer-grid {
      /* marca (âncora, mais larga) | navegar | brindes (2 col) | contato */
      grid-template-columns: 2.4fr 1.2fr 2.8fr 1.7fr;
      column-gap: 2.5rem;
    }
    /* brindes em 2 colunas só onde há largura de sobra pra não quebrar linha */
    .footer-brindes { grid-template-columns: 1fr 1fr; }
    .footer-col--brindes a { font-size: 0.88rem; }
  }
</style>
