---
/*
  Card de depoimento. Só recebe itens já filtrados por publicar:true
  (ver getDepoimentosPublicados) — placeholders nunca chegam aqui.

  Quando fonte='google', exibe as estrelas e o selo "Avaliação no Google":
  avaliação pública e verificável convence muito mais que um depoimento solto,
  porque o visitante sabe que não foi a própria empresa que escreveu.
*/
interface Props {
  texto: string;
  autor: string;
  empresa?: string;
  fonte?: 'google' | 'direto';
  estrelas?: number;
}
const { texto, autor, empresa = '', fonte = 'direto', estrelas = 5 } = Astro.props;
const nota = Math.max(1, Math.min(5, Math.round(estrelas)));
// Iniciais para o avatar (evita hotlink de foto de perfil do Google).
const iniciais = autor
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((p) => p[0])
  .join('')
  .toUpperCase();
---
<figure class="depo">
  <div class="depo__topo">
    <span class="depo__avatar" aria-hidden="true">{iniciais}</span>
    <div class="depo__ident">
      <span class="depo__autor">{autor}</span>
      {empresa && <span class="depo__empresa">{empresa}</span>}
      <span class="depo__estrelas" role="img" aria-label={`${nota} de 5 estrelas`}>
        {Array.from({ length: nota }).map(() => (
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 2.3l2.9 5.9 6.6.9-4.8 4.6 1.2 6.5L12 17.1 6.1 20.2l1.2-6.5-4.8-4.6 6.6-.9z"/>
          </svg>
        ))}
      </span>
    </div>
  </div>

  <blockquote class="depo__quote">{texto}</blockquote>

  {fonte === 'google' && (
    <figcaption class="depo__fonte">
      <svg class="depo__g" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
        <path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/>
        <path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 21.4 7.6 24 12 24z"/>
        <path fill="#FBBC05" d="M5.6 14.7a7.2 7.2 0 0 1 0-4.6v-3H1.8a12 12 0 0 0 0 10.6l3.8-3z"/>
        <path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.2 15.1 0 12 0 7.6 0 3.7 2.6 1.8 6.1l3.8 3C6.5 6.7 9 4.8 12 4.8z"/>
      </svg>
      Avaliação no Google
    </figcaption>
  )}
</figure>

<style>
  .depo {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.5rem 1.35rem;
    box-shadow: var(--shadow-card);
    height: 100%;
    margin: 0;
  }

  .depo__topo { display: flex; align-items: center; gap: 0.75rem; }
  .depo__avatar {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-apice-blue);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .depo__ident { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .depo__autor {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-ink);
    line-height: 1.25;
  }
  .depo__empresa { font-size: 0.85rem; color: var(--color-ink-soft); }
  .depo__estrelas { display: inline-flex; gap: 1px; color: #FBBC05; margin-top: 0.1rem; }

  .depo__quote {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .depo__fonte {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .depo__g { flex: none; }
</style>
