---
/*
  Card de depoimento. Só recebe itens já filtrados por publicar:true
  (ver getDepoimentosPublicados) — placeholders nunca chegam aqui.
*/
interface Props {
  texto: string;
  autor: string;
  empresa: string;
}
const { texto, autor, empresa } = Astro.props;
---
<figure class="depo">
  <svg class="depo__mark" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M9.5 7C6.5 7 4 9.5 4 12.5c0 2.6 1.9 4.5 4.3 4.5.3 0 .6 0 .8-.1-.6 1.2-1.9 2.1-3.4 2.4l.6 1.7c3.4-.7 5.7-3.4 5.7-7.2C12 9.5 11 7 9.5 7zm9 0C15.5 7 13 9.5 13 12.5c0 2.6 1.9 4.5 4.3 4.5.3 0 .6 0 .8-.1-.6 1.2-1.9 2.1-3.4 2.4l.6 1.7c3.4-.7 5.7-3.4 5.7-7.2C21 9.5 20 7 18.5 7z"/></svg>
  <blockquote class="depo__quote">{texto}</blockquote>
  <figcaption class="depo__cite">
    <span class="depo__autor">{autor}</span>
    <span class="depo__empresa">{empresa}</span>
  </figcaption>
</figure>

<style>
  .depo {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.6rem;
    box-shadow: var(--shadow-card);
    height: 100%;
    margin: 0;
  }
  .depo__mark { color: var(--color-apice-red); }
  .depo__quote {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--color-ink);
  }
  .depo__cite { display: flex; flex-direction: column; margin-top: auto; }
  .depo__autor { font-family: var(--font-display); font-weight: 700; color: var(--color-apice-blue); }
  .depo__empresa { font-size: 0.9rem; color: var(--color-ink-soft); }
</style>
