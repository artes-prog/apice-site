---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import CtaWhatsApp from './CtaWhatsApp.astro';
import faixaCta from '../assets/img/faixa-cta.png';
import { mensagens, atendentePorSemente, linkWhatsApp } from '../lib/whatsapp';

/*
  CTA final que fecha TODAS as páginas — a única ação do site é o orçamento no WhatsApp.

  Duas apresentações da MESMA seção (sem JS):
  - Desktop (≥1024px): a faixa desenhada (imagem), com um botão verde BRILHOSO clicável
    posicionado exatamente por cima do botão que já vem no desenho (medido: centro em
    78,5% x 86,5% da faixa). Só o botão é o link — comportamento esperado.
  - Mobile (<1024px): versão em texto legível — a faixa larga vira uma tira minúscula no
    celular, então ali usamos o layout de texto de sempre (fundo azul, título, botão).

  O link do WhatsApp usa o MESMO roteamento por página do CtaWhatsApp (atendente por semente),
  então a distribuição de leads continua igual, página a página.
*/
interface Props {
  titulo?: string;
  texto?: string;
  mensagem?: string;
  semente?: string;
}
const {
  titulo = 'Vamos colocar a sua marca em brindes que a gente produz?',
  texto = 'Fale agora com a nossa equipe. Orçamento sem compromisso, resposta rápida em horário comercial.',
  mensagem = mensagens.generico,
  semente,
} = Astro.props;

const alvo = atendentePorSemente(semente ?? Astro.url.pathname);
const href = linkWhatsApp(alvo.whatsapp, mensagem);
const pagina = Astro.url.pathname;
---
<section class="cta-final">
  <!-- Desktop: faixa desenhada; só o botão brilhoso é clicável, por cima do desenhado -->
  <div class="faixa">
    <Image
      src={faixaCta}
      alt="Vamos colocar a sua marca em brindes que a gente produz? — Ápice Brindes"
      widths={[1024, 1440, 1920, 2400, 3000]}
      sizes="100vw"
      format="webp"
      quality={82}
      class="faixa__img"
    />
    <a
      class="faixa__btn"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Pedir orçamento no WhatsApp (atendimento com ${alvo.nome})`}
      data-wa
      data-pagina={pagina}
      data-atendente={alvo.nome}
    >
      <svg class="faixa__btn-icon" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M16 3C9.4 3 4 8.3 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.6 1.4 5.6 1.4h.2c6.6 0 12-5.3 12-12S22.6 3 16 3zm0 21.8c-1.7 0-3.4-.5-4.9-1.3l-.4-.2-4.9 1 1-4.7-.3-.5C5.6 18.4 5 16.7 5 15 5 9.9 9.9 5.9 16 5.9S27 9.9 27 15s-4.9 9.8-11 9.8zm5.6-7.3c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1c-1.7-.8-2.8-1.5-3.9-3.4-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.4 1 2.8 1.2 3 2 3.1 4.9 4.3c1.8.8 2.5.9 3.4.7.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/>
      </svg>
      <span class="faixa__btn-label">Pedir orçamento no Whatsapp</span>
    </a>
  </div>

  <!-- Mobile: versão de texto legível -->
  <div class="container-site cta-final__inner">
    <Logo variant="branco" class="cta-final__logo" />
    <h2 class="cta-final__title">{titulo}</h2>
    <p class="cta-final__text">{texto}</p>
    <CtaWhatsApp variante="primario" mensagem={mensagem} semente={semente} label="Pedir orçamento no WhatsApp" />
  </div>
</section>

<style>
  .cta-final { background: var(--color-apice-blue); color: #fff; }

  /* ---------- Mobile (padrão): texto legível ---------- */
  .faixa { display: none; }
  .cta-final__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding-block: 3.5rem;
  }
  .cta-final__logo { height: 42px; margin-bottom: 0.5rem; }
  .cta-final__title { color: #fff; font-size: clamp(1.5rem, 4.2vw, 2.3rem); max-width: 20ch; }
  .cta-final__text { color: rgba(255, 255, 255, 0.88); max-width: 52ch; margin-bottom: 0.5rem; }

  /* ---------- Desktop (≥1024px): a faixa desenhada ---------- */
  @media (min-width: 1024px) {
    .cta-final__inner { display: none; }

    .faixa {
      display: block;
      position: relative;
      width: 100%;
      line-height: 0;
      container-type: inline-size; /* o botão escala junto com a faixa (unidades cqw) */
    }
    .faixa__img { width: 100%; height: auto; display: block; }

    /* Botão brilhoso, posicionado exatamente sobre o botão que vem no desenho
       (medido: centro em 78,5% x 86,5% da faixa; cobre o desenhado por inteiro). */
    .faixa__btn {
      position: absolute;
      left: 78.5%;
      top: 86.5%;
      transform: translate(-50%, -50%);
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      white-space: nowrap;
      text-decoration: none;
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05cqw;
      line-height: 1;
      color: #fff;
      padding: 0.62em 1.15em;
      border-radius: 999px;
      background: linear-gradient(180deg, #34e07a 0%, var(--color-wa-green) 55%, var(--color-wa-green-dark) 100%);
      box-shadow: 0 0.35cqw 1.1cqw rgba(31, 190, 91, 0.45), inset 0 0.08cqw 0 rgba(255, 255, 255, 0.55);
      overflow: hidden;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .faixa__btn-icon { width: 1.25em; height: 1.25em; flex: none; }
    .faixa__btn-label { display: inline-block; }
    /* brilho de vidro no topo */
    .faixa__btn::before {
      content: "";
      position: absolute;
      inset: 0 0 45% 0;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0));
      pointer-events: none;
    }
    /* reflexo que varre o botão (o "brilho") */
    .faixa__btn::after {
      content: "";
      position: absolute;
      top: 0;
      left: -60%;
      width: 45%;
      height: 100%;
      transform: skewX(-20deg);
      background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0));
      animation: faixa-brilho 3.4s ease-in-out infinite;
    }
    @keyframes faixa-brilho {
      0% { left: -60%; }
      55%, 100% { left: 130%; }
    }
    /* feedback ao passar o mouse / foco no botão */
    .faixa__btn:hover {
      transform: translate(-50%, -50%) scale(1.05);
      box-shadow: 0 0.5cqw 1.5cqw rgba(31, 190, 91, 0.55), inset 0 0.08cqw 0 rgba(255, 255, 255, 0.55);
    }
    .faixa__btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

    @media (prefers-reduced-motion: reduce) {
      .faixa__btn::after { animation: none; display: none; }
      .faixa__btn:hover { transform: translate(-50%, -50%); }
    }
  }
</style>
