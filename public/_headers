# =============================================================================
# HEADERS — Cloudflare Pages
# =============================================================================

# Segurança em todas as rotas
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # CSP (opcional): ativar depois de escolher a ferramenta de analytics, para
  # não bloquear o embed do Google Maps nem o script de estatística.
  # Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://www.google.com; connect-src 'self'

# Assets com hash no nome: cache imutável e longo
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
